"""
End-to-end checks for the mochajs toolchain.

Each check drives the installed `mochajs` dependency against the sample projects
under `.dagger/modules/e2e/modules`, plus throwaway in-memory workspaces for the
discovery and cwd-scope paths. Run them with `dagger check`.
"""
type E2E {
  """
  The CommonJS sample project, also used as the building block of the synthetic
  multi-project workspaces below. Its `spec` is scoped to its own `test`
  directory, so a copy nested inside another copy is not swept up by its parent.
  """
  let cjsProject: Directory! {
    currentModule.source.directory("modules/cjs")
  }

  """
  The ESM sample project. Mocha is preloaded through a different Node flag for
  ESM than for CommonJS, so both are run end-to-end.
  """
  let esmProject: Directory! {
    currentModule.source.directory("modules/esm")
  }

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  """
  Whether a check failed when run.
  """
  let failed(check: Check!): Boolean! {
    {
      run(check)
      false
    } rescue true
  }

  """
  The failure of a check, or "passed".
  """
  let outcome(check: Check!): String! {
    {
      run(check)
      "passed"
    } rescue {
      err: Error => err.message
    }
  }

  """
  Run every test file of the only project in a workspace, as one whole-project
  run, and report its outcome.
  """
  let wholeOutcome(tool: Mochajs!, ws: Workspace!, key: String!): String! {
    filesOutcome(ws, tool.projects(ws).get(key: key).testFiles(ws))
  }

  """
  The failure of running these test files, or "passed". The project and
  test files functions raise rather than returning a Check: only a test file
  is a check, so that dagger check runs it once.
  """
  let filesOutcome(ws: Workspace!, files: MochajsTestFiles!): String! {
    {
      files.test(ws)
      "passed"
    } rescue {
      err: Error => err.message
    }
  }

  """
  The failure of running one test file of files, through the plain function,
  or "passed".
  """
  let fileOutcome(ws: Workspace!, files: MochajsTestFiles!, file: String!): String! {
    filesOutcome(ws, files.subset(keys: [file]))
  }

  """
  The check of one test, sharing a run with the other tests of selection.
  Direct calls do not apply dagger check's filtered view, so the selection
  is explicit.
  """
  let leaf(ws: Workspace!, selection: MochajsTestFiles!, file: String!, title: String!): Check! {
    selection.get(key: file).tests.get(key: title).test(ws, selection: selection)
  }

  """
  The failure of running these tests of one file, or "passed".
  """
  let testsOutcome(ws: Workspace!, tests: MochajsTests!): String! {
    {
      tests.test(ws)
      "passed"
    } rescue {
      err: Error => err.message
    }
  }

  """
  A package.json for a sample project.
  """
  let packageJson(type: String!, mocha: String!, extra: String!): String! {
    "{\"name\": \"fixture\", \"private\": true, \"type\": \"" + type
      + "\", \"devDependencies\": {\"mocha\": \"" + mocha + "\"}" + extra + "}\n"
  }

  """
  A test that passes only when Mocha's Runner is the instrumented one, which
  is how the spans get recorded.
  """
  let probeCjs: String! =
    "const m = require(\"mocha\");\nconst assert = require(\"node:assert\");\n\ndescribe(\"dagger\", () => {\n  it(\"instruments mocha\", () => {\n    assert.strictEqual((m.default ?? m).Runner.__dagger_instrumented__, true);\n  });\n});\n"

  let probeEsm: String! =
    "import Mocha from \"mocha\";\nimport assert from \"node:assert\";\n\ndescribe(\"dagger\", () => {\n  it(\"instruments mocha\", () => {\n    assert.strictEqual(Mocha.Runner.__dagger_instrumented__, true);\n  });\n});\n"

  """
  The OpenTelemetry instrumentation patches Mocha 11 and Mocha 12, CommonJS
  and ESM: Mocha 12's CLI loads lib/mocha.cjs, which the hook has to match.
  """
  instrumentationCheck: Void @check {
    let cjs11 = cjsProject.withNewFile("test/probe.test.js", probeCjs)
    let esm11 = esmProject.withNewFile("test/probe.test.js", probeEsm)
    let cjs12 = cjs11.withNewFile("package.json", packageJson(
      "commonjs",
      "^12.0.2",
      "",
    ))
    let esm12 = esm11.withNewFile("package.json", packageJson(
      "module",
      "^12.0.2",
      "",
    ))
    let results = [
      "cjs 11: " + wholeOutcome(mochajs, cjs11.asWorkspace, "."),
      "esm 11: " + wholeOutcome(mochajs, esm11.asWorkspace, "."),
      "cjs 12: " + wholeOutcome(mochajs, cjs12.asWorkspace, "."),
      "esm 12: " + wholeOutcome(mochajs, esm12.asWorkspace, "."),
    ]
    assert(
      results.all { r => r.hasSuffix(": passed") },
      "instrumentation: " + results.join("; "),
    )
    null
  }

  """
  A run that never finishes is stopped at the timeout and says why; --exit
  lets Mocha end a run whose tests leave handles open.
  """
  timeoutCheck: Void @check {
    let ws = cjsProject
      .withNewFile("test/hang.test.js", "setInterval(() => {}, 1000);\n")
      .asWorkspace
    let hung = wholeOutcome(mochajs(timeout: 5), ws, ".")
    assert(hung.contains("did not finish within 5s"), "hanging run: " + hung)
    assert(hung.contains("--exit"), "the timeout did not suggest --exit: " + hung)
    let exited = wholeOutcome(mochajs(timeout: 60, flags: ["--exit"]), ws, ".")
    assert(exited == "passed", "run with --exit: " + exited)
    null
  }

  """
  The environment setting reaches the tests, and browser downloads are
  skipped.
  """
  environmentCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "test/env.test.js",
        "const assert = require(\"node:assert\");\n\nit(\"sees the env setting\", () => {\n  assert.strictEqual(process.env.E2E_GREETING, \"hello=world\");\n  assert.strictEqual(process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD, \"1\");\n});\n",
      )
      .asWorkspace
    let without = wholeOutcome(mochajs, ws, ".")
    assert(without != "passed", "the environment test passed without the setting")
    let given = wholeOutcome(
      mochajs(environment: ["E2E_GREETING=hello=world"]),
      ws,
      ".",
    )
    assert(given == "passed", "environment setting: " + given)
    null
  }

  """
  Install failures name the step and the command; installFlags reach it.
  """
  installCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "package.json",
        packageJson("commonjs", "^11.7.5", ", \"scripts\": {\"postinstall\": \"exit 3\"}"),
      )
      .asWorkspace
    let broken = wholeOutcome(mochajs, ws, ".")
    assert(
      broken.contains("install failed (npm install, exit"),
      "a failing install was not named: " + broken,
    )
    let ignored = wholeOutcome(
      mochajs(installFlags: ["--ignore-scripts"]),
      ws,
      ".",
    )
    assert(ignored == "passed", "installFlags: " + ignored)

    let missing = cjsProject
      .withNewFile("package.json", "{\"name\": \"fixture\", \"private\": true}\n")
      .asWorkspace
    let notInstalled = wholeOutcome(mochajs, missing, ".")
    assert(
      notInstalled.contains("mocha is not installed"),
      "a project without mocha: " + notInstalled,
    )
    null
  }

  """
  pnpm copies file: dependencies at install time, so their files are install
  inputs too, not only their package.json.
  """
  localDependencyCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "package.json",
        packageJson(
          "commonjs",
          "^11.7.5",
          ", \"packageManager\": \"pnpm@12.8.1\", \"dependencies\": {\"local-dep\": \"file:./local-dep\"}",
        ),
      )
      .withNewFile("local-dep/package.json", "{\"name\": \"local-dep\", \"version\": \"1.0.0\", \"main\": \"index.js\"}\n")
      .withNewFile("local-dep/index.js", "module.exports = 7;\n")
      .withNewFile(
        "test/local.test.js",
        "const assert = require(\"node:assert\");\n\nit(\"uses a file: dependency\", () => {\n  assert.strictEqual(require(\"local-dep\"), 7);\n});\n",
      )
      .asWorkspace
    let result = wholeOutcome(mochajs, ws, ".")
    assert(result == "passed", "file: dependency: " + result)
    null
  }

  """
  A workspace package's "bin" is linked into node_modules/.bin, so a test can
  run the CLI: the install sees the bin file, not only the manifests. pnpm 10
  skips the link when the file is missing; pnpm 12 links it anyway.
  """
  workspaceBinCheck: Void @check {
    let ws = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"root\", \"private\": true, \"packageManager\": \"pnpm@10.18.3\", \"devDependencies\": {\"mocha\": \"^11.7.5\", \"hello-cli\": \"workspace:*\"}}\n",
      )
      .withNewFile("pnpm-workspace.yaml", "packages:\n  - packages/*\n")
      .withNewFile(
        "packages/hello-cli/package.json",
        "{\"name\": \"hello-cli\", \"version\": \"1.0.0\", \"bin\": {\"hello-cli\": \"bin/hello.js\"}}\n",
      )
      .withNewFile("packages/hello-cli/bin/hello.js", "#!/usr/bin/env node\nconsole.log(\"hello\");\n")
      .withNewFile(".mocharc.json", "{\"spec\": \"test/*.test.js\"}\n")
      .withNewFile(
        "test/cli.test.js",
        "const assert = require(\"node:assert\");\nconst { execFileSync } = require(\"node:child_process\");\n\nit(\"runs a workspace CLI\", () => {\n  assert.strictEqual(execFileSync(\"node_modules/.bin/hello-cli\").toString().trim(), \"hello\");\n});\n",
      )
      .asWorkspace
    let result = wholeOutcome(mochajs, ws, ".")
    assert(result == "passed", "workspace bin: " + result)
    null
  }

  """
  Tests may delete globals the exporter could use (fetch, ReadableStream,
  TextEncoder); the instrumentation must not turn that into a failed run.
  """
  mutatedGlobalsCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "test/globals.test.js",
        "const assert = require(\"node:assert\");\n\ndescribe(\"globals\", () => {\n  afterEach(() => {\n    delete globalThis.ReadableStream;\n    delete globalThis.fetch;\n    delete globalThis.Request;\n    delete globalThis.Response;\n    delete globalThis.Headers;\n  });\n  after(() => {\n    delete globalThis.TextEncoder;\n    delete globalThis.TextDecoder;\n  });\n  for (let i = 0; i < 5; i++) {\n    it(\"test \" + i, async () => {\n      await new Promise((resolve) => setTimeout(resolve, 20));\n      assert.ok(true);\n    });\n  }\n});\n",
      )
      .asWorkspace
    let result = wholeOutcome(mochajs, ws, ".")
    assert(result == "passed", "mutated globals: " + result)
    null
  }

  """
  Dependencies install at the workspace root, so a package can use its
  workspace siblings, and the package manager is detected from package.json.
  """
  packageManagerCheck: Void @check {
    let npmWorkspaces = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"root\", \"private\": true, \"workspaces\": [\"packages/*\"], \"devDependencies\": {\"mocha\": \"^11.7.5\"}}\n",
      )
      .withNewFile("packages/b/package.json", "{\"name\": \"b\", \"version\": \"1.0.0\", \"main\": \"index.js\"}\n")
      .withNewFile("packages/b/index.js", "module.exports = 42;\n")
      .withNewFile("packages/a/package.json", "{\"name\": \"a\", \"version\": \"1.0.0\"}\n")
      .withNewFile("packages/a/.mocharc.json", "{\"spec\": \"test/*.test.js\"}\n")
      .withNewFile(
        "packages/a/test/sibling.test.js",
        "const assert = require(\"node:assert\");\n\nit(\"uses a workspace sibling\", () => {\n  assert.strictEqual(require(\"b\"), 42);\n});\n",
      )
      .asWorkspace
    let sibling = wholeOutcome(mochajs, npmWorkspaces, "packages/a")
    assert(sibling == "passed", "npm workspaces: " + sibling)

    let pnpm = cjsProject
      .withNewFile(
        "package.json",
        packageJson("commonjs", "^11.7.5", ", \"packageManager\": \"pnpm@12.8.1\""),
      )
      .withNewFile(
        "test/pnpm.test.js",
        "const assert = require(\"node:assert\");\nconst fs = require(\"node:fs\");\n\nit(\"was installed by pnpm\", () => {\n  assert.ok(fs.existsSync(\"node_modules/.pnpm\"));\n});\n",
      )
      .asWorkspace
    let detected = wholeOutcome(mochajs, pnpm, ".")
    assert(detected == "passed", "pnpm from packageManager: " + detected)
    null
  }

  """
  Run the toolchain against the sample projects, exercising the real thing:
  discovery, the local build of the otel library, and a Mocha run under both
  module systems, of a whole project, of a single test file and of a single
  test.
  """
  sampleProjectsCheck: Void @check {
    testSample(cjsProject, "cjs fixture")
    testSample(esmProject, "esm fixture")

    null
  }

  let testSample(project: Directory!, suite: String!): Void {
    let ws = project.asWorkspace
    let projects = mochajs.projects(ws)
    assertPaths(projects.keys, ["."], "sample project discovery")
    projects.test(ws)

    let files = projects.get(key: ".").testFiles(ws)
    assertPaths(files.keys, ["test/index.test.js"], "sample test file discovery")
    files.test(ws)

    let file = files.get(key: "test/index.test.js")
    file.test(ws)

    let tests = file.tests
    assertPaths(
      tests.keys,
      [suite + " passes", suite + " nested suite also passes"],
      "sample test discovery",
    )
    tests.test(ws)
    run(leaf(ws, files, "test/index.test.js", suite + " nested suite also passes"))
    null
  }

  """
  `list` reports the tests a project would run without running them.
  """
  listCheck: Void @check {
    let ws = cjsProject.asWorkspace
    let listed = mochajs.projects(ws).get(key: ".").list(ws)

    if (listed.contains("nested suite") == false) {
      raise "list did not report the fixture's tests: " + listed
    }

    null
  }

  """
  Every Mocha config filename is a dotfile, so discovery only works if the glob
  matches hidden files. One project per supported name, all discovered.
  """
  configNameDiscoveryCheck: Void @check {
    let tree = directory
      .withNewFile("js/.mocharc.js", "module.exports = {};\n")
      .withNewFile("cjs/.mocharc.cjs", "module.exports = {};\n")
      .withNewFile("mjs/.mocharc.mjs", "export default {};\n")
      .withNewFile("json/.mocharc.json", "{}\n")
      .withNewFile("jsonc/.mocharc.jsonc", "{}\n")
      .withNewFile("yaml/.mocharc.yaml", "{}\n")
      .withNewFile("yml/.mocharc.yml", "{}\n")

    assertPaths(
      mochajs.projects(tree.asWorkspace).keys,
      ["js", "cjs", "mjs", "json", "jsonc", "yaml", "yml"],
      "one project per config filename",
    )

    null
  }

  """
  Two sibling projects under a root that holds no config of its own:

      a/.mocharc.json
      b/.mocharc.json
  """
  let siblings: Directory! {
    directory
      .withDirectory("a", cjsProject)
      .withDirectory("b", cjsProject)
  }

  """
  A root project with a project nested under each of two subdirectories:

      .mocharc.json
      a/.mocharc.json
      b/.mocharc.json
  """
  let nested: Directory! {
    cjsProject
      .withDirectory("a", cjsProject)
      .withDirectory("b", cjsProject)
  }

  """
  A root project with a nested project under a subdirectory holding no config
  of its own:

      .mocharc.json
      work/                  <- no config
      work/app/.mocharc.json
  """
  let ancestor: Directory! {
    cjsProject.withDirectory("work/app", cjsProject)
  }

  """
  Discovery from `cwd` inside a synthetic workspace built from `tree`.
  """
  let projects(tree: Directory!, cwd: String!): [String!]! {
    mochajs.projects(tree.asWorkspace(cwd: cwd)).keys
  }

  """
  Fail unless discovery returned exactly the wanted paths, in any order.
  """
  let assertPaths(got: [String!]!, want: [String!]!, context: String!): Void {
    let rendered = context + ": got [" + got.join(", ") + "], want [" + want.join(", ") + "]"

    if (got.length != want.length) {
      raise rendered
    }
    want.each { path =>
      if (got.filter { value => value == path }.length != 1) {
        raise rendered
      }
    }
    null
  }

  """
  From a directory in no project, discovery returns every project beneath it;
  entering a project, or any directory inside it, scopes discovery to that
  project alone. Keys are workspace-root-relative wherever the caller stands.
  """
  siblingDiscoveryCheck: Void @check {
    assertPaths(projects(siblings, "."), ["a", "b"], "from the workspace root")
    assertPaths(projects(siblings, "a"), ["a"], "from a")
    assertPaths(projects(siblings, "b"), ["b"], "from b")
    assertPaths(projects(siblings, "a/test"), ["a"], "from a/test")

    let grouped = directory
      .withDirectory("apps/a", cjsProject)
      .withDirectory("apps/b", cjsProject)
      .withDirectory("libs/c", cjsProject)
    assertPaths(projects(grouped, "apps"), ["apps/a", "apps/b"], "from apps")

    null
  }

  """
  A root project does not leak into a nested project's view: the config in the
  cwd shadows the enclosing one, so entering `a` yields `a` alone.
  """
  nestedDiscoveryCheck: Void @check {
    assertPaths(projects(nested, "."), [".", "a", "b"], "from the workspace root")
    assertPaths(projects(nested, "a"), ["a"], "from a")
    assertPaths(projects(nested, "b"), ["b"], "from b")

    null
  }

  """
  From a subdirectory holding no config, the nearest enclosing project is
  reported alongside the projects below the cwd, keyed by its root rather than
  by a ".."-relative path, and that key resolves back to the enclosing project.
  """
  ancestorDiscoveryCheck: Void @check {
    let ws = ancestor.asWorkspace(cwd: "work")
    let found = mochajs.projects(ws)

    assertPaths(found.keys, [".", "work/app"], "from work")

    if (found.get(key: ".").source(ws).glob(".mocharc.json").length != 1) {
      raise "the enclosing project's key did not resolve back to it"
    }

    null
  }

  """
  A dependency ships its own Mocha config, so the walk has to prune
  `node_modules` rather than report what is inside it as a project.
  """
  vendoredDiscoveryCheck: Void @check {
    let vendored = cjsProject.withDirectory("node_modules/dep", cjsProject)

    assertPaths(projects(vendored, "."), ["."], "with a vendored project below")

    null
  }

  """
  Projects form a collection keyed by project root. get builds the project at
  a key; subset keeps parent order, rejects unknown and duplicate keys, and
  narrows what get accepts and what its test function runs; an empty subset
  is valid and runs nothing.
  """
  collectionCheck: Void @check {
    let ws = siblings
      .withDirectory("c", cjsProject)
      .withNewFile("b/test/broken.test.js", failingTest)
      .asWorkspace
    let all = mochajs.projects(ws)
    assert(all.keys == ["a", "b", "c"], "keys were not sorted: " + all.keys.join(", "))
    assert(all.get(key: "b").path == "b", "get did not return the project at its key")

    let pair = all.subset(keys: ["c", "a"])
    assert(pair.keys == ["a", "c"], "subset did not keep parent order: " + pair.keys.join(", "))
    pair.test(ws)

    let outside = { pair.get(key: "b").path } rescue {
      err: Error => "rejected"
    }
    assert(outside == "rejected", "get accepted a key outside the subset")

    let unknown = { all.subset(keys: ["no/such/project"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "subset accepted an unknown key")

    let duplicate = { all.subset(keys: ["a", "a"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(duplicate == "rejected", "subset accepted a duplicate key")

    let none = all.subset(keys: [])
    assert(none.keys.length == 0, "empty subset kept keys: " + none.keys.join(", "))
    none.test(ws)

    let failure = { all.test(ws); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(failure.contains("- b:"), "projects test did not name the failing project: " + failure)
    assert(failure.contains("- a:") == false, "projects test named a passing project: " + failure)
    null
  }

  """
  Test files are keyed by project-relative path, found without running Mocha:
  the spec of a JSON or YAML config (a string or a list; globs, brace
  alternatives, files with or without their extension, and directories),
  `extension` and `recursive` for a directory spec, and Mocha's default
  `./test` otherwise, minus the config's `ignore`. A nested project's files,
  node_modules and files that declare no suite or test are left out, and the
  keys are sorted.
  """
  testFileDiscoveryCheck: Void @check {
    let ws = directory
      .withNewFile("string/.mocharc.json", "{\"spec\": \"test/*.test.js\"}\n")
      .withNewFile("string/test/b.test.js", testSource)
      .withNewFile("string/test/a.test.js", testSource)
      .withNewFile("string/test/helper.js", testSource)
      .withNewFile("string/test/deep/c.test.js", testSource)
      .withNewFile("globbed/.mocharc.json", "{\"spec\": [\"test/**/*.spec.js\"]}\n")
      .withNewFile("globbed/test/unit/a.spec.js", testSource)
      .withNewFile("globbed/test/b.spec.js", testSource)
      .withNewFile(
        "list/.mocharc.yaml",
        "spec:\n  - \"unit/**/*.spec.{js,mjs}\"\n  - ./e2e/smoke.js\n  - lib/helper\n",
      )
      .withNewFile("list/unit/x.spec.js", testSource)
      .withNewFile("list/unit/deep/y.spec.mjs", testSource)
      .withNewFile("list/unit/z.spec.ts", testSource)
      .withNewFile("list/unit/node_modules/dep/q.spec.js", testSource)
      .withNewFile("list/e2e/smoke.js", testSource)
      .withNewFile("list/e2e/other.js", testSource)
      .withNewFile("list/unit/empty.spec.js", "")
      .withNewFile("list/lib/helper.js", testSource)
      .withNewFile(
        "commented/.mocharc.jsonc",
        "// Mocha strips comments\n{\n\t\"spec\": [\"spec\"], /* a directory */\n\t\"extension\": \"ts\",\n\t\"recursive\": true // and walks it\n}\n",
      )
      .withNewFile("commented/spec/a.ts", testSource)
      .withNewFile("commented/spec/deep/b.ts", testSource)
      .withNewFile("commented/spec/c.js", testSource)
      .withNewFile("defaults/.mocharc.js", "module.exports = { spec: [\"other/*.js\"] };\n")
      .withNewFile("defaults/test/a.js", testSource)
      .withNewFile("defaults/test/b.cjs", testSource)
      .withNewFile("defaults/test/c.mjs", testSource)
      .withNewFile("defaults/test/d.ts", testSource)
      .withNewFile("defaults/test/deep/e.js", testSource)
      .withNewFile("defaults/other/f.js", testSource)
      # A helper in the spec declares no test, so it is not a test file.
      .withNewFile("defaults/test/helper.js", "module.exports = { it: 1 };\n")
      .withNewFile("defaults/test/suite.js", "describe.only(\"suite\", () => {});\n")
      .withNewFile(
        "ignored/.mocharc.yml",
        "spec: \"test/**/*.js\"\nignore:\n  - \"test/fixtures/**\"\n",
      )
      .withNewFile("ignored/test/a.js", testSource)
      .withNewFile("ignored/test/fixtures/b.js", testSource)
      .withNewFile("outer/.mocharc.yml", "spec: \"test/**/*.js\"\n")
      .withNewFile("outer/test/a.js", testSource)
      .withNewFile("outer/test/inner/.mocharc.yml", "{}\n")
      .withNewFile("outer/test/inner/test/b.js", testSource)
      .asWorkspace

    assertTestFiles(ws, "string", ["test/a.test.js", "test/b.test.js"])
    assertTestFiles(
      ws,
      "list",
      ["e2e/smoke.js", "lib/helper.js", "unit/deep/y.spec.mjs", "unit/x.spec.js"],
    )
    # A comment marker inside a JSON string is not a comment.
    assertTestFiles(ws, "globbed", ["test/b.spec.js", "test/unit/a.spec.js"])
    assertTestFiles(ws, "commented", ["spec/a.ts", "spec/deep/b.ts"])
    assertTestFiles(ws, "defaults", ["test/a.js", "test/b.cjs", "test/c.mjs", "test/suite.js"])
    assertTestFiles(ws, "ignored", ["test/a.js"])
    assertTestFiles(ws, "outer", ["test/a.js"])
    assertTestFiles(ws, "outer/test/inner", ["test/b.js"])

    # Keys are relative to the project, not the caller.
    let inside = mochajs.projects(ws.withWorkdir("string/test"))
    assert(inside.keys == ["string"], "discovery from inside a project: " + inside.keys.join(", "))
    assert(
      inside.get(key: "string").testFiles(ws).keys == ["test/a.test.js", "test/b.test.js"],
      "test files from inside a project",
    )
    null
  }

  """
  Test file contents for discovery, which only lists files that declare a
  suite or a test.
  """
  let testSource: String! = "it(\"works\", () => {});\n"

  """
  Fail unless the project at path offers exactly the wanted test files, in
  order.
  """
  let assertTestFiles(ws: Workspace!, path: String!, want: [String!]!): Void {
    let got = mochajs.projects(ws).get(key: path).testFiles(ws).keys
    assert(
      got == want,
      path + ": got [" + got.join(", ") + "], want [" + want.join(", ") + "]",
    )
  }

  """
  A project's test files form a collection: with nothing filtered out, its
  test function runs the project as Mocha's own config selects it; a subset
  that leaves files out runs only its own files, even though the config's
  spec covers more.
  """
  testFilesCheck: Void @check {
    let ws = cjsProject.withNewFile("test/broken.test.js", failingTest).asWorkspace
    let files = mochajs.projects(ws).get(key: ".").testFiles(ws)
    assert(
      files.keys == ["test/broken.test.js", "test/index.test.js"],
      "test files: " + files.keys.join(", "),
    )

    assert(
      filesOutcome(ws, files) != "passed",
      "the whole project run missed the failing file",
    )
    let subset = filesOutcome(ws, files.subset(keys: ["test/index.test.js"]))
    assert(subset == "passed", "the passing file as a subset: " + subset)
    let single = fileOutcome(ws, files, "test/index.test.js")
    assert(single == "passed", "the passing file on its own: " + single)
    assert(
      filesOutcome(ws, files.subset(keys: ["test/broken.test.js"])) != "passed",
      "the failing file passed as a subset",
    )
    assert(
      fileOutcome(ws, files, "test/broken.test.js") != "passed",
      "the failing file passed on its own",
    )
    let none = filesOutcome(ws, files.subset(keys: []))
    assert(none == "passed", "an empty subset: " + none)

    # A JS config is not read, so its spec reaches a failing file discovery
    # does not list. Only the whole run, which is Mocha's own, runs it.
    let hidden = cjsProject
      .withoutFile(".mocharc.json")
      .withNewFile(
        ".mocharc.cjs",
        "module.exports = { spec: [\"test/*.test.js\", \"extra/*.js\"] };\n",
      )
      .withNewFile("extra/broken.js", failingTest)
      .asWorkspace
    let hiddenFiles = mochajs.projects(hidden).get(key: ".").testFiles(hidden)
    assert(
      hiddenFiles.keys == ["test/index.test.js"],
      "test files under a JS config: " + hiddenFiles.keys.join(", "),
    )
    assert(
      filesOutcome(hidden, hiddenFiles) != "passed",
      "the whole run did not use Mocha's own config",
    )
    # A JS config hides its interface, so the file has only "*". With nothing
    # selected out, its check shares that whole run too, and the
    # unlisted file's failure, which no check owns, fails it.
    let listedFile = outcome(leaf(hidden, hiddenFiles, "test/index.test.js", "*"))
    assert(
      listedFile.contains("failures in test files without selected test checks: extra/broken.js"),
      "the listed file under a JS config: " + listedFile,
    )
    null
  }

  """
  Each test is a check. The checks of a project share one Mocha run of their
  selection, and each reports only its own test: the passing test passes
  while another fails, and a test outside the selection is refused.
  """
  leafCheck: Void @check {
    let ws = cjsProject.withNewFile("test/broken.test.js", failingTest).asWorkspace
    let files = mochajs.projects(ws).get(key: ".").testFiles(ws)
    run(leaf(ws, files, "test/index.test.js", "cjs fixture passes"))
    let broken = outcome(leaf(ws, files, "test/broken.test.js", "broken fails"))
    assert(
      broken.contains("broken fails failed") and broken.contains("1 == 2"),
      "the failing test did not fail on its own: " + broken,
    )
    let outside = outcome(
      files.get(key: "test/broken.test.js").tests.get(key: "broken fails").test(
        ws,
        selection: files.subset(keys: ["test/index.test.js"]),
      ),
    )
    assert(
      outside.contains("outside the test selection"),
      "a test outside its selection: " + outside,
    )
    null
  }

  """
  A test file's tests form a collection keyed by the full title --grep
  matches, read from the source: literal titles of the suites around a test
  and its own. A test whose title is made at run time is under the key "*".
  With nothing selected out the file runs whole; a subset runs only the tests
  selected, anchored to their full title so a title another one starts with
  does not pull that one in, and "*" runs the file's unnamed tests.
  """
  testsCheck: Void @check {
    let ws = cjsProject
      .withNewFile("test/dimension.test.js", dimensionTests)
      .asWorkspace
    let files = mochajs.projects(ws).get(key: ".").testFiles(ws)
    let tests = files.get(key: "test/dimension.test.js").tests
    assert(
      tests.keys == ["dimension passes", "dimension passes twice", "dimension fails", "*"],
      "tests: " + tests.keys.join(", "),
    )
    assert(testsOutcome(ws, tests) != "passed", "the whole file run missed the failing test")
    let subset = testsOutcome(ws, tests.subset(keys: ["dimension passes", "*"]))
    assert(subset == "passed", "a passing subset: " + subset)
    let none = testsOutcome(ws, tests.subset(keys: []))
    assert(none == "passed", "an empty subset: " + none)
    run(leaf(ws, files, "test/dimension.test.js", "dimension passes"))
    run(leaf(ws, files, "test/dimension.test.js", "*"))
    let twice = outcome(leaf(ws, files, "test/dimension.test.js", "dimension passes twice"))
    assert(
      twice.contains("dimension passes twice failed"),
      "the failing test did not fail on its own: " + twice,
    )
    null
  }

  """
  Static titles, without a container: suites nest, a template literal
  without interpolation names a test, and a test is named only when every
  scope around it is the file, a block or a named suite's callback. Tests in
  a forEach callback, a loop with a computed title, a helper function, an
  arrow helper, or a suite with a computed title are under "*". The tdd
  interface names suite and test; the exports interface and a JavaScript
  config, whose interface is not read, leave every file at "*".
  """
  parserCheck: Void @check {
    let bdd = "describe(\"outer\", () => {\n"
      + "  it(\"plain\", () => {});\n"
      + "  // it(\"commented\", () => {});\n"
      + "  describe('inner (x)', function () {\n"
      + "    it(`tpl`, async () => { const s = \"it('in string')\"; });\n"
      + "    if (process.env.X) { it(\"conditional\", () => {}); }\n"
      + "  });\n"
      + "  [\"a\", \"b\"].forEach((n) => { it(\"each \" + n, () => {}); it(\"fixed\", () => {}); });\n"
      + "  for (const n of [1]) { it(`loop ${n}`, () => {}); }\n"
      + "  it.skip(\"skipped\", () => {});\n"
      + "  xit(\"pending\");\n"
      + "  context(\"ctx\", () => it(\"arrow\", () => {}));\n"
      + "  beforeEach(() => { it(\"in a hook\", () => {}); });\n"
      + "});\n"
      + "function helper(name) { it(name, () => {}); it(\"literal in helper\", () => {}); }\n"
      + "const make = () => { it(\"made\", () => {}); };\n"
      + "describe(\"dyn \" + 1, () => { it(\"under dynamic\", () => {}); });\n"
    let named = "describe(\"only\", () => { it(\"one\", () => {}); });\n"
    # Tests that run only sometimes, if at all, are not named; a plain block
    # and a statement after a call on the line before are.
    let conditional = "describe(\"c\", () => {\n"
      + "  it(\"plain\", () => {});\n"
      + "  { it(\"blocked\", () => {}); }\n"
      + "  if (process.env.X) { it(\"if braced\", () => {}); } else { it(\"else braced\", () => {}); }\n"
      + "  if (process.env.X) it(\"if bare\", () => {});\n"
      + "  else it(\"else bare\", () => {});\n"
      + "  try { it(\"in try\", () => {}); } catch (e) { it(\"in catch\", () => {}); } finally { it(\"in finally\", () => {}); }\n"
      + "  switch (1) { case 1: it(\"in switch\", () => {}); }\n"
      + "  process.env.X ? it(\"ternary a\", () => {}) : it(\"ternary b\", () => {});\n"
      + "  process.env.X && it(\"and\", () => {});\n"
      + "  while (false) it(\"while bare\", () => {});\n"
      + "  Math.max()\n"
      + "  it(\"after a call\", () => {});\n"
      + "});\n"
    let tree = directory
      .withNewFile("bdd/.mocharc.json", "{\"spec\": \"test/*.js\"}\n")
      .withNewFile("bdd/test/a.js", bdd)
      .withNewFile("bdd/test/b.js", named)
      .withNewFile("bdd/test/c.js", conditional)
      .withNewFile("tdd/.mocharc.yml", "spec: test/*.js\nui: tdd\n")
      .withNewFile("tdd/test/c.js", "suite(\"tdd\", function () {\n  test(\"works\", function () {});\n  suiteSetup(() => {});\n});\n")
      .withNewFile("exports/.mocharc.json", "{\"ui\": \"exports\"}\n")
      .withNewFile("exports/test/d.js", named)
      .withNewFile("js/.mocharc.js", "module.exports = {};\n")
      .withNewFile("js/test/e.js", named)
    let ws = tree.asWorkspace
    let a = keys(ws, "bdd", "test/a.js")
    assert(
      a == ["outer plain", "outer inner (x) tpl", "outer skipped", "outer pending", "outer ctx arrow", "*"],
      "bdd titles: " + a.join(", "),
    )
    assert(keys(ws, "bdd", "test/b.js") == ["only one"], "a fully named file has no *")
    let c = keys(ws, "bdd", "test/c.js")
    assert(c == ["c plain", "c blocked", "c after a call", "*"], "conditional titles: " + c.join(", "))
    assert(keys(ws, "tdd", "test/c.js") == ["tdd works"], "tdd titles: " + keys(ws, "tdd", "test/c.js").join(", "))
    assert(keys(ws, "exports", "test/d.js") == ["*"], "exports ui: " + keys(ws, "exports", "test/d.js").join(", "))
    assert(keys(ws, "js", "test/e.js") == ["*"], "JS config: " + keys(ws, "js", "test/e.js").join(", "))
    let flagged = mochajs(flags: ["--ui", "tdd"]).projects(ws).get(key: "bdd").testFiles(ws).get(key: "test/b.js").tests.keys
    assert(flagged == ["*"], "the --ui flag was not read: " + flagged.join(", "))
    null
  }

  """
  The test keys of a file of a project.
  """
  let keys(ws: Workspace!, project: String!, file: String!): [String!]! {
    mochajs.projects(ws).get(key: project).testFiles(ws).get(key: file).tests.keys
  }

  """
  A test file whose titles exercise the selector: one title that another
  starts with, one computed as the file loads, which the source does not
  name, and two failing tests.
  """
  let dimensionTests: String! =
    "const assert = require(\"node:assert\");\n\ndescribe(\"dimension\", () => {\n  it(\"passes\", () => {});\n  it(\"passes twice\", () => {\n    assert.equal(1, 2);\n  });\n  for (const name of [\"a|b\"]) {\n    it(name, () => {});\n  }\n  it(\"fails\", () => {\n    assert.equal(1, 2);\n  });\n});\n"

  """
  A file that throws while Mocha loads it stops Mocha's whole run, since
  Mocha loads every file before it runs one. Its checks fail with the
  reason, and the other files of the project still report their own tests,
  from a run of each file alone; listing never loads a file, so it is
  unaffected, and so are the other projects.
  """
  loadFailureCheck: Void @check {
    let ws = directory
      .withDirectory("good", cjsProject)
      .withDirectory("bad", cjsProject)
      .withNewFile(
        "bad/test/broken.test.js",
        "describe(\"broken\", () => { it(\"syntax error\"  => {}); });\n",
      )
      .asWorkspace
    let badFiles = mochajs.projects(ws).get(key: "bad").testFiles(ws)
    assert(
      badFiles.keys == ["test/broken.test.js", "test/index.test.js"],
      "test files of the broken project: " + badFiles.keys.join(", "),
    )
    let why = outcome(leaf(ws, badFiles, "test/broken.test.js", "*"))
    assert(
      why.contains("test/broken.test.js failed on its own") and why.contains("SyntaxError"),
      "the file that throws did not say why: " + why,
    )
    run(leaf(ws, badFiles, "test/index.test.js", "cjs fixture passes"))
    let goodFiles = mochajs.projects(ws).get(key: "good").testFiles(ws)
    run(leaf(ws, goodFiles, "test/index.test.js", "cjs fixture passes"))
    null
  }

  """
  Mocha 12 is ESM and renamed the config loaders a filtered run borrows, so a
  filtered run is checked against it too: the ESM sample project, its
  `.mocharc.json` spec, and a failing file that only the whole run reaches.
  """
  mocha12Check: Void @check {
    let ws = esmProject
      .withNewFile(
        "package.json",
        "{\"name\": \"mocha-fixture-esm-12\", \"private\": true, \"type\": \"module\", \"devDependencies\": {\"mocha\": \"^12.0.2\"}}\n",
      )
      .withNewFile(
        "test/broken.test.js",
        "import assert from \"node:assert\";\n\ndescribe(\"broken\", () => {\n  it(\"fails\", () => {\n    assert.equal(1, 2);\n  });\n});\n",
      )
      .asWorkspace
    let files = mochajs.projects(ws).get(key: ".").testFiles(ws)
    assert(
      files.keys == ["test/broken.test.js", "test/index.test.js"],
      "test files: " + files.keys.join(", "),
    )
    let single = fileOutcome(ws, files, "test/index.test.js")
    assert(single == "passed", "the passing file on its own: " + single)
    let subset = filesOutcome(ws, files.subset(keys: ["test/index.test.js"]))
    assert(subset == "passed", "the passing file as a subset: " + subset)
    assert(
      filesOutcome(ws, files) != "passed",
      "the whole project run missed the failing file",
    )

    # The checks name their files too, so they borrow the loaders as well.
    run(leaf(ws, files.subset(keys: ["test/index.test.js"]), "test/index.test.js", "esm fixture passes"))
    null
  }

  """
  Settings apply to every run: flags reach Mocha whether the project runs
  whole or file by file, and a --grep in them leaves the tests it excludes
  without a key.
  """
  settingsCheck: Void @check {
    let ws = cjsProject.withNewFile("test/broken.test.js", failingTest).asWorkspace
    let files = mochajs(flags: ["--grep", "passes"]).projects(ws).get(key: ".").testFiles(ws)
    let whole = filesOutcome(ws, files)
    assert(whole == "passed", "flags on a whole run: " + whole)
    let filtered = fileOutcome(ws, files, "test/broken.test.js")
    assert(filtered == "passed", "flags on a file run: " + filtered)
    let keys = files.get(key: "test/broken.test.js").tests.keys
    assert(keys.length == 0, "--grep in flags left keys: " + keys.join(", "))
    null
  }

  """
  A failing test file, used to observe which projects a run actually covered.
  """
  let failingTest: String! =
    "const assert = require(\"node:assert\");\n\ndescribe(\"broken\", () => {\n  it(\"fails\", () => {\n    assert.equal(1, 2);\n  });\n});\n"

  """
  Whether testing every project visible from `cwd` observed the failure
  planted in `tree`, through the projects' test function and through the test
  files of each project.
  """
  let testFailed(tree: Directory!, cwd: String!): Boolean! {
    let ws = tree.asWorkspace(cwd: cwd)
    let all = mochajs.projects(ws)
    let whole = {
      all.test(ws)
      false
    } rescue true
    let perProject = all.keys.any { key =>
      filesOutcome(ws, all.get(key: key).testFiles(ws)) != "passed"
    }
    if (whole != perProject) {
      raise "the projects and their test files disagreed from " + cwd
    }
    whole
  }

  """
  Testing from the workspace root runs every project below it, and entering
  one of them leaves its siblings out of reach.
  """
  descendantScopeCheck: Void @check {
    let broken = siblings.withNewFile("b/test/broken.test.js", failingTest)

    if (testFailed(broken, ".") == false) {
      raise "testing from the workspace root should have run the project b"
    }
    if (testFailed(broken, "a")) {
      raise "testing from a should not have run the sibling project b"
    }
    if (testFailed(broken, "a/test")) {
      raise "testing from a/test should not have run the sibling project b"
    }
    if (testFailed(
      siblings.withNewFile("a/test/broken.test.js", failingTest),
      "a",
    ) == false) {
      raise "testing from a should have run a's own tests"
    }
    if (testFailed(
      siblings.withNewFile("a/test/broken.test.js", failingTest),
      "a/test",
    ) == false) {
      raise "testing from a/test should have run the enclosing project a"
    }

    null
  }

  """
  A cwd holding no config sits inside its enclosing project, so that project is
  tested too rather than only the ones below the cwd.
  """
  ancestorScopeCheck: Void @check {
    if (testFailed(
      ancestor.withNewFile("test/broken.test.js", failingTest),
      "work",
    ) == false) {
      raise "testing from work should have run the enclosing project"
    }

    null
  }

  # Only the unindented CHECKS header counts: nested TESTS summaries count the
  # Mocha tests, which can be right even when the checks are attributed wrong.
  let checkSummaryMatches(output: String!, passed: Int!, failed: Int!): Boolean! {
    let headers = output.split("\n").filter { line =>
      line.hasPrefix("CHECKS ") or line.hasPrefix("== CHECKS ==")
    }
    let empty: [String!]! = []
    let expected = (if (failed > 0) { ["✘", toString(failed), "failed"] } else { empty })
      + (if (passed > 0) { ["✔", toString(passed), "passed"] } else { empty })
    headers.length == 1 and headers[0]!.trimPrefix("== ").trimPrefix("CHECKS").trimPrefix(" ==")
      .trimSpace.split(" ").filter { word => word != "" } == expected
  }

  """
  The check totals the selection checks assert are read from the CHECKS
  header alone.
  """
  selectedSummaryCheck: Void @check {
    let wrong = "CHECKS  ✘ 8 failed\n  TESTS\n    ✘ 1 failed\n    ✔ 7 passed\n"
    assert(checkSummaryMatches(wrong, 7, 1) == false, "nested test counts hid failed checks")
    assert(checkSummaryMatches(wrong, 0, 8), "zero passing checks were not recognized")
    assert(checkSummaryMatches("CHECKS  ✔ 18 passed\n", 8, 0) == false, "accepted a partial count")
    assert(checkSummaryMatches("CHECKS  ✘ 1 failed  ✔ 7 passed\n", 7, 1), "mixed counts were not recognized")
    assert(checkSummaryMatches("== CHECKS ==  ✔ 8 passed\n", 8, 0), "agent report was not recognized")
    assert(checkSummaryMatches("  CHECKS  ✔ 8 passed\n", 8, 0) == false, "accepted a nested header")
    null
  }

  """
  Run dagger check over a fixture workspace that installs this repository's
  module, with the engine's own CLI in a session of its own. Direct Dang
  calls do not apply dagger check's filtered view of the collections, so
  selection is only exercised through the CLI.
  """
  let selectedRun(ws: Workspace!, fixture: Directory!, args: [String!]!): Container! {
    container
      .from("alpine:3.23")
      # Test file discovery searches the workspace on the client, with
      # ripgrep when it is there; busybox grep cannot stand in for it.
      .withExec(["apk", "add", "--no-cache", "ripgrep"])
      .withEnvVariable("NO_COLOR", "1")
      .withDirectory(
        "/source",
        ws.directory("/", exclude: ["**/node_modules", ".git", ".dagger", "dist", "tests"]),
      )
      .withDirectory("/work", fixture)
      .withNewFile("/work/.git/HEAD", "ref: refs/heads/main\n")
      .withNewFile("/work/dagger.toml", "[modules.mochajs]\nsource = \"/source\"\n")
      .withWorkdir("/work")
      .withExec(
        ["/dev/.dagger/dagger", "check"] + args,
        expect: ReturnType.ANY,
        daggerInDaggerNewSession: true,
      )
  }

  let selectedCheck(
    ws: Workspace!,
    fixture: Directory!,
    args: [String!]!,
    passed: Int!,
    failed: Int! = 0,
    messages: [String!]! = [],
  ): Void {
    let result = selectedRun(ws, fixture, ["--progress=report"] + args)
    let output = result.stdout + result.stderr
    assert((result.exitCode == 0) == (failed == 0), "unexpected check exit status:\n" + output)
    assert(checkSummaryMatches(output, passed, failed), "unexpected Dagger check totals:\n" + output)
    messages.map { message =>
      assert(output.contains(message), "missing " + message + ":\n" + output)
    }
    null
  }

  """
  A test file of one suite.
  """
  let suiteFile(body: String!): String! {
    "const assert = require(\"node:assert\");\n\ndescribe(\"suite\", () => {\n" + body + "});\n"
  }

  let passingTests: String! = "  it(\"foo\", () => {});\n  it(\"bar\", () => {});\n"

  """
  A Mocha project at root whose test files hold the given sources.
  """
  let selectionProject(tree: Directory!, root: String!, files: [String!]!, source: String!): Directory! {
    files.reduce(
      tree
        .withNewFile(root + "/package.json", packageJson("commonjs", "^11.7.5", ""))
        .withNewFile(root + "/.mocharc.json", "{\"spec\": \"test/*.test.js\"}\n"),
    ) { acc, file => acc.withNewFile(root + "/" + file, source) }
  }

  """
  Two projects, a and b, of three test files each: x and y pass, and z fails
  if it runs.
  """
  let selectionFixture: Directory! {
    ["a", "b"].reduce(directory) { tree, root =>
      selectionProject(tree, root, ["test/x.test.js", "test/y.test.js"], suiteFile(passingTests))
        .withNewFile(
          root + "/test/z.test.js",
          suiteFile("  it(\"other\", () => { assert.fail(\"excluded file ran\"); });\n"),
        )
    }
  }

  let selectionArgs: [String!]! = ["--mochajs-test-file=test/x.test.js", "--mochajs-test-file=test/y.test.js"]

  """
  Two projects of two selected test files of two tests: eight checks, and
  the excluded file does not run.
  """
  selectedTestsCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, selectionFixture, selectionArgs, passed: 8)
  }

  """
  Selecting a project runs every test in it, and only in it.
  """
  selectedProjectCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture,
      ["--mochajs-project=a"],
      passed: 4,
      failed: 1,
      messages: ["suite other failed", "excluded file ran"],
    )
  }

  """
  One selected test runs alone, in one Mocha run: the other tests of its file
  pass the --grep by, so a failing one does not fail it.
  """
  selectedSingleTestCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      suiteFile("  it(\"foo\", () => {});\n  it(\"bar\", () => { assert.fail(\"unselected test ran\"); });\n"),
    )
    let args = ["--mochajs-project=a", "--mochajs-test-file=test/x.test.js", "--mochajs-test=suite foo"]
    selectedCheck(ws, fixture, args, passed: 1)
    let output = selectedOutput(ws, fixture, ["--progress=plain", "-vvv"] + args)
    let runs = mochaRuns(output)
    assert(runs.length == 1, "Mocha ran " + toString(runs.length) + " times for one test")
    let commands = output.split("\n").filter { line =>
      line.contains("withExec sh /dagger-mocha/timeout.sh") and line.contains("report.json")
    }
    assert(
      commands.all { line => line.contains("--grep '^(?:(?:suite foo)$)'") and line.contains("test/y.test.js") == false },
      "the run was not narrowed to the test:\n" + commands.join("\n"),
    )
    null
  }

  """
  A failing test fails its own check and no other.
  """
  selectedFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      suiteFile("  it(\"foo\", () => { assert.fail(\"selected failure\"); });\n  it(\"bar\", () => {});\n"),
    )
    selectedCheck(ws, fixture, selectionArgs, passed: 7, failed: 1, messages: ["suite foo failed", "selected failure"])
  }

  """
  A test made in a forEach callback is under "*": its failure fails "*" and
  no named test. With "*" not selected it does not run.
  """
  selectedForEachCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      suiteFile(passingTests + "  [\"g1\", \"g2\"].forEach((n) => {\n    it(\"gen \" + n, () => { if (n === \"g2\") assert.fail(\"generated failure\"); });\n  });\n"),
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 8,
      failed: 1,
      messages: ["unnamed tests of test/x.test.js failed", "generated failure"],
    )
    selectedCheck(ws, fixture, selectionArgs + ["--mochajs-test=suite foo", "--mochajs-test=suite bar"], passed: 8)
  }

  """
  A test a helper function defines is not keyed by its literal title, which
  its caller may change; it is under "*".
  """
  selectedHelperCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      "const assert = require(\"node:assert\");\n"
        + "function helper() { it(\"bar\", () => { assert.fail(\"helper failure\"); }); }\n"
        + "describe(\"suite\", () => {\n  it(\"foo\", () => {});\n  helper();\n});\n",
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 7,
      failed: 1,
      messages: ["unnamed tests of test/x.test.js failed", "helper failure"],
    )
    let output = selectedOutput(ws, fixture, ["-l", "--all", "--mochajs-project=a", "--mochajs-test-file=test/x.test.js"])
    let rows = listedRows(output)
    assert(
      rows == ["a|test/x.test.js|*", "a|test/x.test.js|suite foo"] or rows == ["a|test/x.test.js|suite foo", "a|test/x.test.js|*"],
      "helper keys:\n" + rows.join("\n"),
    )
    null
  }

  """
  Nested suites join their titles into the test's full title.
  """
  selectedNestedCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      "const assert = require(\"node:assert\");\n"
        + "describe(\"outer\", () => {\n  describe(\"inner\", () => {\n    it(\"deep\", () => { assert.fail(\"nested failure\"); });\n  });\n  it(\"shallow\", () => {});\n});\n",
    )
    selectedCheck(
      ws,
      fixture,
      ["--mochajs-project=a", "--mochajs-test=outer inner deep", "--mochajs-test=outer shallow"],
      passed: 1,
      failed: 1,
      messages: ["outer inner deep failed", "nested failure"],
    )
  }

  """
  The tdd interface, set in the config, names suite and test.
  """
  selectedTddCheck(ws: Workspace!): Void @check {
    let fixture = directory
      .withNewFile("tdd/package.json", packageJson("commonjs", "^11.7.5", ""))
      .withNewFile("tdd/.mocharc.yml", "spec: test/*.test.js\nui: tdd\n")
      .withNewFile(
        "tdd/test/x.test.js",
        "const assert = require(\"node:assert\");\nsuite(\"tsuite\", function () {\n  test(\"one\", function () {});\n  test(\"two\", function () { assert.fail(\"tdd failure\"); });\n});\n",
      )
    selectedCheck(ws, fixture, [], passed: 1, failed: 1, messages: ["tsuite two failed", "tdd failure"])
  }

  """
  A failing hook fails the selected tests under its suite.
  """
  selectedHookFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "b/test/y.test.js",
      suiteFile("  before(() => { throw new Error(\"setup failure\"); });\n" + passingTests),
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 6,
      failed: 2,
      messages: ["suite foo failed", "setup failure"],
    )
  }

  """
  A file that throws while Mocha loads it stops its project's run: that
  file's checks fail with the reason, the project's other files still pass,
  and so does the other project.
  """
  selectedLoadFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "b/test/x.test.js",
      "throw new Error(\"load failure\");\n" + suiteFile(passingTests),
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 6,
      failed: 2,
      messages: ["test/x.test.js failed on its own", "load failure"],
    )
  }

  """
  A JS config's spec reaches a file discovery does not list, which only the
  whole run of the project runs: its failure belongs to no selected test, so
  it fails them all.
  """
  selectedUnlistedFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionProject(directory, "c", ["test/x.test.js", "test/y.test.js"], suiteFile(passingTests))
      .withoutFile("c/.mocharc.json")
      .withNewFile("c/.mocharc.cjs", "module.exports = { spec: [\"test/*.test.js\", \"extra/*.js\"] };\n")
      .withNewFile("c/extra/broken.js", failingTest)
    selectedCheck(
      ws,
      fixture,
      ["--mochajs-project=c"],
      passed: 0,
      failed: 2,
      messages: ["failures in test files without selected test checks: extra/broken.js"],
    )
  }

  """
  A named test Mocha never runs fails as not run, rather than passing with
  nothing behind it.
  """
  selectedNeverRanCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      suiteFile("  it(\"foo\", () => {});\n  return;\n  it(\"ghost\", () => {});\n"),
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 7,
      failed: 1,
      messages: ["suite ghost did not run"],
    )
  }

  """
  A test under an if is not named, as it may not exist: it is under "*",
  which passes with no unnamed test run, rather than failing as not run.
  """
  selectedConditionalCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      suiteFile(passingTests + "  if (process.env.E2E_NEVER_SET) {\n    it(\"ghost\", () => {});\n  }\n"),
    )
    selectedCheck(ws, fixture, selectionArgs, passed: 9)
  }

  """
  A .only holds every file of Mocha's run, and Mocha passes the tests it
  leaves out, so their checks pass too. Under forbidOnly, Mocha throws as it
  loads the file that calls .only, and that file's checks fail.
  """
  selectedOnlyCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "a/test/x.test.js",
      suiteFile("  it.only(\"foo\", () => {});\n  it(\"bar\", () => { assert.fail(\"left out by only\"); });\n"),
    )
    selectedCheck(ws, fixture, selectionArgs, passed: 8)
    let forbidden = fixture.withNewFile(
      "a/.mocharc.json",
      "{\"spec\": \"test/*.test.js\", \"forbidOnly\": true}\n",
    )
    # Mocha throws as it loads the file that calls .only, so only that file's
    # tests fail.
    selectedCheck(ws, forbidden, selectionArgs, passed: 6, failed: 2, messages: ["forbidden by --forbid-only"])
  }

  """
  A project whose test files cannot be found fails alone, naming its config;
  the other project is unaffected.
  """
  selectedDiscoveryFailureCheck(ws: Workspace!): Void @check {
    let a = selectionProject(directory, "a", ["test/x.test.js"], suiteFile(passingTests))
    let fixture = selectionProject(a, "b", ["test/x.test.js"], suiteFile(passingTests))
      .withNewFile("b/.mocharc.json", "{\"spec\": }\n")
    selectedCheck(
      ws,
      fixture,
      [],
      passed: 2,
      failed: 1,
      messages: ["cannot read b/.mocharc.json"],
    )
  }

  """
  Every selected test of a project shares one Mocha run: eight checks over
  two projects run Mocha twice, once per project.
  """
  selectedDedupCheck(ws: Workspace!): Void @check {
    let output = selectedOutput(ws, selectionFixture, ["--progress=plain", "-vvv"] + selectionArgs)
    let runs = mochaRuns(output)
    assert(
      runs.length == 2,
      "Mocha ran " + toString(runs.length) + " times for 2 projects:\n" + output.split("\n").takeLast(80).join("\n"),
    )
    null
  }

  """
  The output of a dagger check run that must pass.
  """
  let selectedOutput(ws: Workspace!, fixture: Directory!, args: [String!]!): String! {
    let result = selectedRun(ws, fixture, args)
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "dagger check " + args.join(" ") + " failed:\n" + output)
    output
  }

  """
  The ids of the spans that ran a project's shared Mocha run. Plain progress
  prints each span's id before its name; a run cached for another check is no
  span of its own.
  """
  let mochaRuns(output: String!): [String!]! {
    output
      .split("\n")
      .filter { line =>
        line.contains("withExec sh /dagger-mocha/timeout.sh")
          and line.contains("output=/dagger-mocha/report.json")
      }
      .map { line => line.split(":").takeFirst(1).join("").trimSpace }
      .uniq
  }

  """
  The rows dagger check -l lists for this module, as project|file|test.
  """
  let listedRows(output: String!): [String!]! {
    output
      .split("\n")
      .filter { line => line.hasPrefix("mochajs ") }
      .map { line => line.replaceMatches(`\s{2,}`, with: "|").split("|").takeFirst(4).dropFirst(1).join("|") }
  }

  """
  Listing runs no tool: with a project whose install fails and one whose
  Mocha config does not parse, every test is still listed, and nothing is
  installed and no Mocha runs.
  """
  selectedListingCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture
      .withNewFile(
        "a/package.json",
        packageJson("commonjs", "^11.7.5", ", \"scripts\": {\"postinstall\": \"exit 3\"}"),
      )
      .withNewFile("b/.mocharc.json", "{\"spec\": }\n")
    let output = selectedOutput(ws, fixture, ["--progress=plain", "-vvv", "-l", "--all"])
    let rows = listedRows(output)
    let want = [
      "a|test/x.test.js|suite foo",
      "a|test/x.test.js|suite bar",
      "a|test/y.test.js|suite foo",
      "a|test/y.test.js|suite bar",
      "a|test/z.test.js|suite other",
      "b|.mocharc.json|*",
    ]
    assert(
      rows.length == want.length and want.all { key => rows.contains(key) },
      "listed rows:\n" + rows.join("\n") + "\n" + output.split("\n").takeLast(40).join("\n"),
    )
    let tools = output.split("\n").filter { line =>
      line.contains("withExec") and (
        line.contains("npm install") or line.contains("/dagger-mocha/") or line.contains("--dry-run")
      )
    }
    assert(tools.length == 0, "listing ran a tool:\n" + tools.join("\n"))
    null
  }
}
