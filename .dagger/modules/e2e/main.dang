"""
End-to-end checks for the mochajs toolchain.

Each check drives the installed `mochajs` dependency against the sample projects
under `.dagger/modules/e2e/modules`, plus throwaway in-memory workspaces for the
discovery and cwd-scope paths. Run them with `dagger check`.
"""
type E2E {
  """
  The CommonJS sample project, also used as the building block of the synthetic
  multi-project workspaces below. Its `spec` is scoped to its own `test`
  directory, so a copy nested inside another copy is not swept up by its parent.
  """
  let cjsProject: Directory! {
    currentModule.source.directory("modules/cjs")
  }

  """
  The ESM sample project. Mocha is preloaded through a different Node flag for
  ESM than for CommonJS, so both are run end-to-end.
  """
  let esmProject: Directory! {
    currentModule.source.directory("modules/esm")
  }

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  """
  Whether a check failed when run.
  """
  let failed(check: Check!): Boolean! {
    {
      run(check)
      false
    } rescue true
  }

  """
  The failure of a check, or "passed".
  """
  let outcome(check: Check!): String! {
    {
      run(check)
      "passed"
    } rescue {
      err: Error => err.message
    }
  }

  """
  Run every test file of the only project in a workspace, as one whole-project
  batch, and report its outcome.
  """
  let wholeOutcome(tool: Mochajs!, ws: Workspace!, key: String!): String! {
    filesOutcome(ws, tool.projects(ws).get(key: key).testFiles(ws))
  }

  """
  The failure of running these test files, or "passed". The project and test
  file functions raise rather than returning a Check: only the tests of a
  file are checks, so that dagger check runs them once.
  """
  let filesOutcome(ws: Workspace!, files: MochajsTestFiles!): String! {
    {
      files.batch.test(ws)
      "passed"
    } rescue {
      err: Error => err.message
    }
  }

  """
  The failure of running this test file, or "passed".
  """
  let fileOutcome(ws: Workspace!, file: MochajsTestFile!): String! {
    {
      file.test(ws)
      "passed"
    } rescue {
      err: Error => err.message
    }
  }

  """
  A package.json for a sample project.
  """
  let packageJson(type: String!, mocha: String!, extra: String!): String! {
    "{\"name\": \"fixture\", \"private\": true, \"type\": \"" + type
      + "\", \"devDependencies\": {\"mocha\": \"" + mocha + "\"}" + extra + "}\n"
  }

  """
  A test that passes only when Mocha's Runner is the instrumented one, which
  is how the spans get recorded.
  """
  let probeCjs: String! =
    "const m = require(\"mocha\");\nconst assert = require(\"node:assert\");\n\ndescribe(\"dagger\", () => {\n  it(\"instruments mocha\", () => {\n    assert.strictEqual((m.default ?? m).Runner.__dagger_instrumented__, true);\n  });\n});\n"

  let probeEsm: String! =
    "import Mocha from \"mocha\";\nimport assert from \"node:assert\";\n\ndescribe(\"dagger\", () => {\n  it(\"instruments mocha\", () => {\n    assert.strictEqual(Mocha.Runner.__dagger_instrumented__, true);\n  });\n});\n"

  """
  The OpenTelemetry instrumentation patches Mocha 11 and Mocha 12, CommonJS
  and ESM: Mocha 12's CLI loads lib/mocha.cjs, which the hook has to match.
  """
  instrumentationCheck: Void @check {
    let cjs11 = cjsProject.withNewFile("test/probe.test.js", probeCjs)
    let esm11 = esmProject.withNewFile("test/probe.test.js", probeEsm)
    let cjs12 = cjs11.withNewFile("package.json", packageJson(
      "commonjs",
      "^12.0.2",
      "",
    ))
    let esm12 = esm11.withNewFile("package.json", packageJson(
      "module",
      "^12.0.2",
      "",
    ))
    let results = [
      "cjs 11: " + wholeOutcome(mochajs, cjs11.asWorkspace, "."),
      "esm 11: " + wholeOutcome(mochajs, esm11.asWorkspace, "."),
      "cjs 12: " + wholeOutcome(mochajs, cjs12.asWorkspace, "."),
      "esm 12: " + wholeOutcome(mochajs, esm12.asWorkspace, "."),
    ]
    assert(
      results.all { r => r.hasSuffix(": passed") },
      "instrumentation: " + results.join("; "),
    )
    null
  }

  """
  A run that never finishes is stopped at the timeout and says why; --exit
  lets Mocha end a run whose tests leave handles open.
  """
  timeoutCheck: Void @check {
    let ws = cjsProject
      .withNewFile("test/hang.test.js", "setInterval(() => {}, 1000);\n")
      .asWorkspace
    let hung = wholeOutcome(mochajs(timeout: 5), ws, ".")
    assert(hung.contains("did not finish within 5s"), "hanging run: " + hung)
    assert(hung.contains("--exit"), "the timeout did not suggest --exit: " + hung)
    let exited = wholeOutcome(mochajs(timeout: 60, flags: ["--exit"]), ws, ".")
    assert(exited == "passed", "run with --exit: " + exited)
    null
  }

  """
  The environment setting reaches the tests, and browser downloads are
  skipped.
  """
  environmentCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "test/env.test.js",
        "const assert = require(\"node:assert\");\n\nit(\"sees the env setting\", () => {\n  assert.strictEqual(process.env.E2E_GREETING, \"hello=world\");\n  assert.strictEqual(process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD, \"1\");\n});\n",
      )
      .asWorkspace
    let without = wholeOutcome(mochajs, ws, ".")
    assert(without != "passed", "the environment test passed without the setting")
    let given = wholeOutcome(
      mochajs(environment: ["E2E_GREETING=hello=world"]),
      ws,
      ".",
    )
    assert(given == "passed", "environment setting: " + given)
    null
  }

  """
  Install failures name the step and the command; installFlags reach it.
  """
  installCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "package.json",
        packageJson("commonjs", "^11.7.5", ", \"scripts\": {\"postinstall\": \"exit 3\"}"),
      )
      .asWorkspace
    let broken = wholeOutcome(mochajs, ws, ".")
    assert(
      broken.contains("install failed (npm install, exit"),
      "a failing install was not named: " + broken,
    )
    let ignored = wholeOutcome(
      mochajs(installFlags: ["--ignore-scripts"]),
      ws,
      ".",
    )
    assert(ignored == "passed", "installFlags: " + ignored)

    let missing = cjsProject
      .withNewFile("package.json", "{\"name\": \"fixture\", \"private\": true}\n")
      .asWorkspace
    let notInstalled = wholeOutcome(mochajs, missing, ".")
    assert(
      notInstalled.contains("mocha is not installed"),
      "a project without mocha: " + notInstalled,
    )
    null
  }

  """
  pnpm copies file: dependencies at install time, so their files are install
  inputs too, not only their package.json.
  """
  localDependencyCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "package.json",
        packageJson(
          "commonjs",
          "^11.7.5",
          ", \"packageManager\": \"pnpm@12.8.1\", \"dependencies\": {\"local-dep\": \"file:./local-dep\"}",
        ),
      )
      .withNewFile("local-dep/package.json", "{\"name\": \"local-dep\", \"version\": \"1.0.0\", \"main\": \"index.js\"}\n")
      .withNewFile("local-dep/index.js", "module.exports = 7;\n")
      .withNewFile(
        "test/local.test.js",
        "const assert = require(\"node:assert\");\n\nit(\"uses a file: dependency\", () => {\n  assert.strictEqual(require(\"local-dep\"), 7);\n});\n",
      )
      .asWorkspace
    let result = wholeOutcome(mochajs, ws, ".")
    assert(result == "passed", "file: dependency: " + result)
    null
  }

  """
  A workspace package's "bin" is linked into node_modules/.bin, so a test can
  run the CLI: the install sees the bin file, not only the manifests. pnpm 10
  skips the link when the file is missing; pnpm 12 links it anyway.
  """
  workspaceBinCheck: Void @check {
    let ws = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"root\", \"private\": true, \"packageManager\": \"pnpm@10.18.3\", \"devDependencies\": {\"mocha\": \"^11.7.5\", \"hello-cli\": \"workspace:*\"}}\n",
      )
      .withNewFile("pnpm-workspace.yaml", "packages:\n  - packages/*\n")
      .withNewFile(
        "packages/hello-cli/package.json",
        "{\"name\": \"hello-cli\", \"version\": \"1.0.0\", \"bin\": {\"hello-cli\": \"bin/hello.js\"}}\n",
      )
      .withNewFile("packages/hello-cli/bin/hello.js", "#!/usr/bin/env node\nconsole.log(\"hello\");\n")
      .withNewFile(".mocharc.json", "{\"spec\": \"test/*.test.js\"}\n")
      .withNewFile(
        "test/cli.test.js",
        "const assert = require(\"node:assert\");\nconst { execFileSync } = require(\"node:child_process\");\n\nit(\"runs a workspace CLI\", () => {\n  assert.strictEqual(execFileSync(\"node_modules/.bin/hello-cli\").toString().trim(), \"hello\");\n});\n",
      )
      .asWorkspace
    let result = wholeOutcome(mochajs, ws, ".")
    assert(result == "passed", "workspace bin: " + result)
    null
  }

  """
  A project with a Mocha config but no package.json anywhere above it runs
  Mocha through npx.
  """
  noPackageJsonCheck: Void @check {
    let ws = directory
      .withNewFile(".mocharc.json", "{\"spec\": \"test/*.test.js\"}\n")
      .withNewFile(
        "test/add.test.js",
        "const assert = require(\"node:assert\");\n\nit(\"adds\", () => {\n  assert.strictEqual(1 + 1, 2);\n});\n",
      )
      .asWorkspace
    let result = wholeOutcome(mochajs(timeout: 300), ws, ".")
    assert(result == "passed", "no package.json: " + result)
    null
  }

  """
  Tests may delete globals the exporter could use (fetch, ReadableStream,
  TextEncoder); the instrumentation must not turn that into a failed run.
  """
  mutatedGlobalsCheck: Void @check {
    let ws = cjsProject
      .withNewFile(
        "test/globals.test.js",
        "const assert = require(\"node:assert\");\n\ndescribe(\"globals\", () => {\n  afterEach(() => {\n    delete globalThis.ReadableStream;\n    delete globalThis.fetch;\n    delete globalThis.Request;\n    delete globalThis.Response;\n    delete globalThis.Headers;\n  });\n  after(() => {\n    delete globalThis.TextEncoder;\n    delete globalThis.TextDecoder;\n  });\n  for (let i = 0; i < 5; i++) {\n    it(\"test \" + i, async () => {\n      await new Promise((resolve) => setTimeout(resolve, 20));\n      assert.ok(true);\n    });\n  }\n});\n",
      )
      .asWorkspace
    let result = wholeOutcome(mochajs, ws, ".")
    assert(result == "passed", "mutated globals: " + result)
    null
  }

  """
  Dependencies install at the workspace root, so a package can use its
  workspace siblings, and the package manager is detected from package.json.
  """
  packageManagerCheck: Void @check {
    let npmWorkspaces = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"root\", \"private\": true, \"workspaces\": [\"packages/*\"], \"devDependencies\": {\"mocha\": \"^11.7.5\"}}\n",
      )
      .withNewFile("packages/b/package.json", "{\"name\": \"b\", \"version\": \"1.0.0\", \"main\": \"index.js\"}\n")
      .withNewFile("packages/b/index.js", "module.exports = 42;\n")
      .withNewFile("packages/a/package.json", "{\"name\": \"a\", \"version\": \"1.0.0\"}\n")
      .withNewFile("packages/a/.mocharc.json", "{\"spec\": \"test/*.test.js\"}\n")
      .withNewFile(
        "packages/a/test/sibling.test.js",
        "const assert = require(\"node:assert\");\n\nit(\"uses a workspace sibling\", () => {\n  assert.strictEqual(require(\"b\"), 42);\n});\n",
      )
      .asWorkspace
    let sibling = wholeOutcome(mochajs, npmWorkspaces, "packages/a")
    assert(sibling == "passed", "npm workspaces: " + sibling)

    let pnpm = cjsProject
      .withNewFile(
        "package.json",
        packageJson("commonjs", "^11.7.5", ", \"packageManager\": \"pnpm@12.8.1\""),
      )
      .withNewFile(
        "test/pnpm.test.js",
        "const assert = require(\"node:assert\");\nconst fs = require(\"node:fs\");\n\nit(\"was installed by pnpm\", () => {\n  assert.ok(fs.existsSync(\"node_modules/.pnpm\"));\n});\n",
      )
      .asWorkspace
    let detected = wholeOutcome(mochajs, pnpm, ".")
    assert(detected == "passed", "pnpm from packageManager: " + detected)
    null
  }

  """
  Run the toolchain against the sample projects, exercising the real thing:
  discovery, the local build of the otel library, and a Mocha run under both
  module systems, of a whole project, of a single test file and of a single
  test.
  """
  sampleProjectsCheck: Void @check {
    testSample(cjsProject, "cjs fixture")
    testSample(esmProject, "esm fixture")

    null
  }

  let testSample(project: Directory!, suite: String!): Void {
    let ws = project.asWorkspace
    let projects = mochajs.projects(ws)
    assertPaths(projects.keys, ["."], "sample project discovery")
    projects.batch.test(ws)

    let files = projects.get(key: ".").testFiles(ws)
    assertPaths(files.keys, ["test/index.test.js"], "sample test file discovery")
    files.batch.test(ws)

    let file = files.get(key: "test/index.test.js")
    file.test(ws)

    let tests = file.tests(ws)
    assertPaths(
      tests.keys,
      [suite + " passes", suite + " nested suite also passes"],
      "sample test discovery",
    )
    run(tests.batch.test(ws))
    run(tests.get(key: suite + " nested suite also passes").test(ws))
    null
  }

  """
  `list` reports the tests a project would run without running them.
  """
  listCheck: Void @check {
    let ws = cjsProject.asWorkspace
    let listed = mochajs.projects(ws).get(key: ".").list(ws)

    if (listed.contains("nested suite") == false) {
      raise "list did not report the fixture's tests: " + listed
    }

    null
  }

  """
  Every Mocha config filename is a dotfile, so discovery only works if the glob
  matches hidden files. One project per supported name, all discovered.
  """
  configNameDiscoveryCheck: Void @check {
    let tree = directory
      .withNewFile("js/.mocharc.js", "module.exports = {};\n")
      .withNewFile("cjs/.mocharc.cjs", "module.exports = {};\n")
      .withNewFile("mjs/.mocharc.mjs", "export default {};\n")
      .withNewFile("json/.mocharc.json", "{}\n")
      .withNewFile("jsonc/.mocharc.jsonc", "{}\n")
      .withNewFile("yaml/.mocharc.yaml", "{}\n")
      .withNewFile("yml/.mocharc.yml", "{}\n")

    assertPaths(
      mochajs.projects(tree.asWorkspace).keys,
      ["js", "cjs", "mjs", "json", "jsonc", "yaml", "yml"],
      "one project per config filename",
    )

    null
  }

  """
  Two sibling projects under a root that holds no config of its own:

      a/.mocharc.json
      b/.mocharc.json
  """
  let siblings: Directory! {
    directory
      .withDirectory("a", cjsProject)
      .withDirectory("b", cjsProject)
  }

  """
  A root project with a project nested under each of two subdirectories:

      .mocharc.json
      a/.mocharc.json
      b/.mocharc.json
  """
  let nested: Directory! {
    cjsProject
      .withDirectory("a", cjsProject)
      .withDirectory("b", cjsProject)
  }

  """
  A root project with a nested project under a subdirectory holding no config
  of its own:

      .mocharc.json
      work/                  <- no config
      work/app/.mocharc.json
  """
  let ancestor: Directory! {
    cjsProject.withDirectory("work/app", cjsProject)
  }

  """
  Discovery from `cwd` inside a synthetic workspace built from `tree`.
  """
  let projects(tree: Directory!, cwd: String!): [String!]! {
    mochajs.projects(tree.asWorkspace(cwd: cwd)).keys
  }

  """
  Fail unless discovery returned exactly the wanted paths, in any order.
  """
  let assertPaths(got: [String!]!, want: [String!]!, context: String!): Void {
    let rendered = context + ": got [" + got.join(", ") + "], want [" + want.join(", ") + "]"

    if (got.length != want.length) {
      raise rendered
    }
    want.each { path =>
      if (got.filter { value => value == path }.length != 1) {
        raise rendered
      }
    }
    null
  }

  """
  From a directory in no project, discovery returns every project beneath it;
  entering a project, or any directory inside it, scopes discovery to that
  project alone. Keys are workspace-root-relative wherever the caller stands.
  """
  siblingDiscoveryCheck: Void @check {
    assertPaths(projects(siblings, "."), ["a", "b"], "from the workspace root")
    assertPaths(projects(siblings, "a"), ["a"], "from a")
    assertPaths(projects(siblings, "b"), ["b"], "from b")
    assertPaths(projects(siblings, "a/test"), ["a"], "from a/test")

    let grouped = directory
      .withDirectory("apps/a", cjsProject)
      .withDirectory("apps/b", cjsProject)
      .withDirectory("libs/c", cjsProject)
    assertPaths(projects(grouped, "apps"), ["apps/a", "apps/b"], "from apps")

    null
  }

  """
  A root project does not leak into a nested project's view: the config in the
  cwd shadows the enclosing one, so entering `a` yields `a` alone.
  """
  nestedDiscoveryCheck: Void @check {
    assertPaths(projects(nested, "."), [".", "a", "b"], "from the workspace root")
    assertPaths(projects(nested, "a"), ["a"], "from a")
    assertPaths(projects(nested, "b"), ["b"], "from b")

    null
  }

  """
  From a subdirectory holding no config, the nearest enclosing project is
  reported alongside the projects below the cwd, keyed by its root rather than
  by a ".."-relative path, and that key resolves back to the enclosing project.
  """
  ancestorDiscoveryCheck: Void @check {
    let ws = ancestor.asWorkspace(cwd: "work")
    let found = mochajs.projects(ws)

    assertPaths(found.keys, [".", "work/app"], "from work")

    if (found.get(key: ".").source(ws).glob(".mocharc.json").length != 1) {
      raise "the enclosing project's key did not resolve back to it"
    }

    null
  }

  """
  A dependency ships its own Mocha config, so the walk has to prune
  `node_modules` rather than report what is inside it as a project.
  """
  vendoredDiscoveryCheck: Void @check {
    let vendored = cjsProject.withDirectory("node_modules/dep", cjsProject)

    assertPaths(projects(vendored, "."), ["."], "with a vendored project below")

    null
  }

  """
  Projects form a collection keyed by project root. get builds the project at
  a key; subset keeps parent order, rejects unknown and duplicate keys, and
  narrows what get accepts and what the batch runs; an empty subset is valid
  and runs nothing.
  """
  collectionCheck: Void @check {
    let ws = siblings
      .withDirectory("c", cjsProject)
      .withNewFile("b/test/broken.test.js", failingTest)
      .asWorkspace
    let all = mochajs.projects(ws)
    assert(all.keys == ["a", "b", "c"], "keys were not sorted: " + all.keys.join(", "))
    assert(all.get(key: "b").path == "b", "get did not return the project at its key")

    let pair = all.subset(keys: ["c", "a"])
    assert(pair.keys == ["a", "c"], "subset did not keep parent order: " + pair.keys.join(", "))
    pair.batch.test(ws)

    let outside = { pair.get(key: "b").path } rescue {
      err: Error => "rejected"
    }
    assert(outside == "rejected", "get accepted a key outside the subset")

    let unknown = { all.subset(keys: ["no/such/project"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "subset accepted an unknown key")

    let duplicate = { all.subset(keys: ["a", "a"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(duplicate == "rejected", "subset accepted a duplicate key")

    let none = all.subset(keys: [])
    assert(none.keys.length == 0, "empty subset kept keys: " + none.keys.join(", "))
    none.batch.test(ws)

    let failure = { all.batch.test(ws); "unexpected success" } rescue {
      err: Error => err.message
    }
    assert(failure.contains("- b:"), "batch test did not name the failing project: " + failure)
    assert(failure.contains("- a:") == false, "batch test named a passing project: " + failure)
    null
  }

  """
  Test files are keyed by project-relative path, found without running Mocha:
  the spec of a JSON or YAML config (a string or a list; globs, brace
  alternatives, files with or without their extension, and directories),
  `extension` and `recursive` for a directory spec, and Mocha's default
  `./test` otherwise. A nested project's files, node_modules and empty files
  are left out, and the keys are sorted.
  """
  testFileDiscoveryCheck: Void @check {
    let ws = directory
      .withNewFile("string/.mocharc.json", "{\"spec\": \"test/*.test.js\"}\n")
      .withNewFile("string/test/b.test.js", testSource)
      .withNewFile("string/test/a.test.js", testSource)
      .withNewFile("string/test/helper.js", testSource)
      .withNewFile("string/test/deep/c.test.js", testSource)
      .withNewFile("globbed/.mocharc.json", "{\"spec\": [\"test/**/*.spec.js\"]}\n")
      .withNewFile("globbed/test/unit/a.spec.js", testSource)
      .withNewFile("globbed/test/b.spec.js", testSource)
      .withNewFile(
        "list/.mocharc.yaml",
        "spec:\n  - \"unit/**/*.spec.{js,mjs}\"\n  - ./e2e/smoke.js\n  - lib/helper\n",
      )
      .withNewFile("list/unit/x.spec.js", testSource)
      .withNewFile("list/unit/deep/y.spec.mjs", testSource)
      .withNewFile("list/unit/z.spec.ts", testSource)
      .withNewFile("list/unit/node_modules/dep/q.spec.js", testSource)
      .withNewFile("list/e2e/smoke.js", testSource)
      .withNewFile("list/e2e/other.js", testSource)
      .withNewFile("list/unit/empty.spec.js", "")
      .withNewFile("list/lib/helper.js", testSource)
      .withNewFile(
        "commented/.mocharc.jsonc",
        "// Mocha strips comments\n{\n\t\"spec\": [\"spec\"], /* a directory */\n\t\"extension\": \"ts\",\n\t\"recursive\": true // and walks it\n}\n",
      )
      .withNewFile("commented/spec/a.ts", testSource)
      .withNewFile("commented/spec/deep/b.ts", testSource)
      .withNewFile("commented/spec/c.js", testSource)
      .withNewFile("defaults/.mocharc.js", "module.exports = { spec: [\"other/*.js\"] };\n")
      .withNewFile("defaults/test/a.js", testSource)
      .withNewFile("defaults/test/b.cjs", testSource)
      .withNewFile("defaults/test/c.mjs", testSource)
      .withNewFile("defaults/test/d.ts", testSource)
      .withNewFile("defaults/test/deep/e.js", testSource)
      .withNewFile("defaults/other/f.js", testSource)
      .withNewFile("outer/.mocharc.yml", "spec: \"test/**/*.js\"\n")
      .withNewFile("outer/test/a.js", testSource)
      .withNewFile("outer/test/inner/.mocharc.yml", "{}\n")
      .withNewFile("outer/test/inner/test/b.js", testSource)
      .asWorkspace

    assertTestFiles(ws, "string", ["test/a.test.js", "test/b.test.js"])
    assertTestFiles(
      ws,
      "list",
      ["e2e/smoke.js", "lib/helper.js", "unit/deep/y.spec.mjs", "unit/x.spec.js"],
    )
    # A comment marker inside a JSON string is not a comment.
    assertTestFiles(ws, "globbed", ["test/b.spec.js", "test/unit/a.spec.js"])
    assertTestFiles(ws, "commented", ["spec/a.ts", "spec/deep/b.ts"])
    assertTestFiles(ws, "defaults", ["test/a.js", "test/b.cjs", "test/c.mjs"])
    assertTestFiles(ws, "outer", ["test/a.js"])
    assertTestFiles(ws, "outer/test/inner", ["test/b.js"])

    # Keys are relative to the project, not the caller.
    let inside = mochajs.projects(ws.withWorkdir("string/test"))
    assert(inside.keys == ["string"], "discovery from inside a project: " + inside.keys.join(", "))
    assert(
      inside.get(key: "string").testFiles(ws).keys == ["test/a.test.js", "test/b.test.js"],
      "test files from inside a project",
    )
    null
  }

  """
  Test file contents for discovery, which only lists non-empty files.
  """
  let testSource: String! = "// a test\n"

  """
  Fail unless the project at path offers exactly the wanted test files, in
  order.
  """
  let assertTestFiles(ws: Workspace!, path: String!, want: [String!]!): Void {
    let got = mochajs.projects(ws).get(key: path).testFiles(ws).keys
    assert(
      got == want,
      path + ": got [" + got.join(", ") + "], want [" + want.join(", ") + "]",
    )
  }

  """
  A project's test files form a collection: with nothing filtered out, the
  batch runs the project as Mocha's own config selects it; a subset, or one
  file, runs only its own files, even though the config's spec covers more.
  """
  testFilesCheck: Void @check {
    let ws = cjsProject.withNewFile("test/broken.test.js", failingTest).asWorkspace
    let files = mochajs.projects(ws).get(key: ".").testFiles(ws)
    assert(
      files.keys == ["test/broken.test.js", "test/index.test.js"],
      "test files: " + files.keys.join(", "),
    )

    assert(
      filesOutcome(ws, files) != "passed",
      "the whole project run missed the failing file",
    )
    let subset = filesOutcome(ws, files.subset(keys: ["test/index.test.js"]))
    assert(subset == "passed", "the passing file as a subset: " + subset)
    let single = fileOutcome(ws, files.get(key: "test/index.test.js"))
    assert(single == "passed", "the passing file on its own: " + single)
    assert(
      filesOutcome(ws, files.subset(keys: ["test/broken.test.js"])) != "passed",
      "the failing file passed as a subset",
    )
    assert(
      fileOutcome(ws, files.get(key: "test/broken.test.js")) != "passed",
      "the failing file passed on its own",
    )
    let none = filesOutcome(ws, files.subset(keys: []))
    assert(none == "passed", "an empty subset: " + none)

    # A JS config is not read, so its spec reaches a failing file discovery
    # does not list. Only the whole run, which is Mocha's own, runs it.
    let hidden = cjsProject
      .withoutFile(".mocharc.json")
      .withNewFile(
        ".mocharc.cjs",
        "module.exports = { spec: [\"test/*.test.js\", \"extra/*.js\"] };\n",
      )
      .withNewFile("extra/broken.js", failingTest)
      .asWorkspace
    let hiddenFiles = mochajs.projects(hidden).get(key: ".").testFiles(hidden)
    assert(
      hiddenFiles.keys == ["test/index.test.js"],
      "test files under a JS config: " + hiddenFiles.keys.join(", "),
    )
    assert(
      filesOutcome(hidden, hiddenFiles) != "passed",
      "the whole run did not use Mocha's own config",
    )
    let listedFile = fileOutcome(hidden, hiddenFiles.get(key: "test/index.test.js"))
    assert(listedFile == "passed", "the listed file under a JS config: " + listedFile)
    null
  }

  """
  A test file's tests form a collection keyed by the full title Mocha
  reports, listed by a dry run rather than by reading the source: a title
  Mocha computes as it loads the file is listed as it will appear. With
  nothing selected out the batch runs the whole file; a subset, or one test,
  runs only the tests selected, anchored to their full title so a title
  another one starts with does not pull that one in.
  """
  testsCheck: Void @check {
    let ws = cjsProject
      .withNewFile("test/dimension.test.js", dimensionTests)
      .asWorkspace
    let file = mochajs
      .projects(ws)
      .get(key: ".")
      .testFiles(ws)
      .get(key: "test/dimension.test.js")
    let tests = file.tests(ws)
    assert(
      tests.keys == [
        "dimension passes",
        "dimension passes twice",
        "dimension a|b",
        "dimension fails",
      ],
      "tests: " + tests.keys.join(", "),
    )

    assert(failed(tests.batch.test(ws)), "the whole file run missed the failing test")
    run(tests.subset(keys: ["dimension passes", "dimension a|b"]).batch.test(ws))
    run(tests.get(key: "dimension passes").test(ws))
    assert(
      failed(tests.get(key: "dimension passes twice").test(ws)),
      "the failing test passed on its own",
    )
    run(tests.subset(keys: []).batch.test(ws))

    # Only the file the tests belong to runs, even though the project's spec
    # covers more.
    let other = mochajs
      .projects(ws)
      .get(key: ".")
      .testFiles(ws)
      .get(key: "test/index.test.js")
      .tests(ws)
    run(other.batch.test(ws))
    null
  }

  """
  A project whose tests Mocha cannot list still has something to run: each of
  its files keeps the unlisted key, running it reports why, and the projects
  that are fine are untouched. Dagger needs every key before it runs
  anything, so a project that cannot list its tests must not raise.
  """
  unlistableTestsCheck: Void @check {
    let ws = directory
      .withDirectory("good", cjsProject)
      .withDirectory("bad", cjsProject)
      # A file that throws while Mocha loads it, which fails the dry run of
      # the whole project, so no file of it can list its tests.
      .withNewFile(
        "bad/test/broken.test.js",
        "describe(\"broken\", () => { it(\"syntax error\"  => {}); });\n",
      )
      .asWorkspace
    let badFiles = mochajs.projects(ws).get(key: "bad").testFiles(ws)

    # The file that throws reports it, through the key that stands for the
    # whole file.
    let brokenTests = badFiles.get(key: "test/broken.test.js").tests(ws)
    assert(brokenTests.keys == ["*"], "unlisted tests: " + brokenTests.keys.join(", "))
    let why = outcome(brokenTests.batch.test(ws))
    assert(why.contains("Mocha failed in bad"), "the unlisted file did not say why: " + why)
    assert(
      failed(brokenTests.get(key: "*").test(ws)),
      "the unlisted key passed instead of running the file",
    )

    # Its siblings lose their per-test keys, since one dry run covers the
    # project, but still run.
    let siblingTests = badFiles.get(key: "test/index.test.js").tests(ws)
    assert(siblingTests.keys == ["*"], "sibling tests: " + siblingTests.keys.join(", "))
    run(siblingTests.batch.test(ws))

    # The healthy project lists and runs as usual.
    let goodTests = mochajs
      .projects(ws)
      .get(key: "good")
      .testFiles(ws)
      .get(key: "test/index.test.js")
      .tests(ws)
    assertPaths(
      goodTests.keys,
      ["cjs fixture passes", "cjs fixture nested suite also passes"],
      "tests of the healthy project",
    )
    run(goodTests.batch.test(ws))
    null
  }

  """
  A test file whose titles exercise the selector: one title that another
  starts with, one computed as the file loads, one holding a regular
  expression metacharacter, and one failing test.
  """
  let dimensionTests: String! =
    "const assert = require(\"node:assert\");\n\ndescribe(\"dimension\", () => {\n  it(\"passes\", () => {});\n  it(\"passes twice\", () => {\n    assert.equal(1, 2);\n  });\n  for (const name of [\"a|b\"]) {\n    it(name, () => {});\n  }\n  it(\"fails\", () => {\n    assert.equal(1, 2);\n  });\n});\n"

  """
  Mocha 12 is ESM and renamed the config loaders a filtered run borrows, so a
  filtered run is checked against it too: the ESM sample project, its
  `.mocharc.json` spec, and a failing file that only the whole run reaches.
  """
  mocha12Check: Void @check {
    let ws = esmProject
      .withNewFile(
        "package.json",
        "{\"name\": \"mocha-fixture-esm-12\", \"private\": true, \"type\": \"module\", \"devDependencies\": {\"mocha\": \"^12.0.2\"}}\n",
      )
      .withNewFile(
        "test/broken.test.js",
        "import assert from \"node:assert\";\n\ndescribe(\"broken\", () => {\n  it(\"fails\", () => {\n    assert.equal(1, 2);\n  });\n});\n",
      )
      .asWorkspace
    let files = mochajs.projects(ws).get(key: ".").testFiles(ws)
    assert(
      files.keys == ["test/broken.test.js", "test/index.test.js"],
      "test files: " + files.keys.join(", "),
    )
    let file = files.get(key: "test/index.test.js")
    let single = fileOutcome(ws, file)
    assert(single == "passed", "the passing file on its own: " + single)
    let subset = filesOutcome(ws, files.subset(keys: ["test/index.test.js"]))
    assert(subset == "passed", "the passing file as a subset: " + subset)
    assert(
      filesOutcome(ws, files) != "passed",
      "the whole project run missed the failing file",
    )

    # Mocha 12 renamed the config loaders a filtered run borrows, so the
    # per-test selector is checked against it too.
    let tests = file.tests(ws)
    assert(
      tests.keys == ["esm fixture passes", "esm fixture nested suite also passes"],
      "tests: " + tests.keys.join(", "),
    )
    run(tests.get(key: "esm fixture passes").test(ws))
    null
  }

  """
  Settings apply to every run: flags reach Mocha whether the project runs
  whole or file by file. They reach the dry run that lists tests too, so a
  test the flags exclude is not a key.
  """
  settingsCheck: Void @check {
    let ws = cjsProject.withNewFile("test/broken.test.js", failingTest).asWorkspace
    let files = mochajs(flags: ["--grep", "passes"]).projects(ws).get(key: ".").testFiles(ws)
    let whole = filesOutcome(ws, files)
    assert(whole == "passed", "flags on a whole run: " + whole)
    let broken = files.get(key: "test/broken.test.js")
    let filtered = fileOutcome(ws, broken)
    assert(filtered == "passed", "flags on a file run: " + filtered)
    assert(
      broken.tests(ws).keys.length == 0,
      "flags did not reach the dry run: " + broken.tests(ws).keys.join(", "),
    )
    null
  }

  """
  A failing test file, used to observe which projects a run actually covered.
  """
  let failingTest: String! =
    "const assert = require(\"node:assert\");\n\ndescribe(\"broken\", () => {\n  it(\"fails\", () => {\n    assert.equal(1, 2);\n  });\n});\n"

  """
  Whether testing every project visible from `cwd` observed the failure
  planted in `tree`, through the project batch and through the test file
  checks of each project.
  """
  let testFailed(tree: Directory!, cwd: String!): Boolean! {
    let ws = tree.asWorkspace(cwd: cwd)
    let all = mochajs.projects(ws)
    let batch = {
      all.batch.test(ws)
      false
    } rescue true
    let checks = all.keys.any { key =>
      filesOutcome(ws, all.get(key: key).testFiles(ws)) != "passed"
    }
    if (batch != checks) {
      raise "the project batch and the test file checks disagreed from " + cwd
    }
    batch
  }

  """
  Testing from the workspace root runs every project below it, and entering
  one of them leaves its siblings out of reach.
  """
  descendantScopeCheck: Void @check {
    let broken = siblings.withNewFile("b/test/broken.test.js", failingTest)

    if (testFailed(broken, ".") == false) {
      raise "testing from the workspace root should have run the project b"
    }
    if (testFailed(broken, "a")) {
      raise "testing from a should not have run the sibling project b"
    }
    if (testFailed(broken, "a/test")) {
      raise "testing from a/test should not have run the sibling project b"
    }
    if (testFailed(
      siblings.withNewFile("a/test/broken.test.js", failingTest),
      "a",
    ) == false) {
      raise "testing from a should have run a's own tests"
    }
    if (testFailed(
      siblings.withNewFile("a/test/broken.test.js", failingTest),
      "a/test",
    ) == false) {
      raise "testing from a/test should have run the enclosing project a"
    }

    null
  }

  """
  A cwd holding no config sits inside its enclosing project, so that project is
  tested too rather than only the ones below the cwd.
  """
  ancestorScopeCheck: Void @check {
    if (testFailed(
      ancestor.withNewFile("test/broken.test.js", failingTest),
      "work",
    ) == false) {
      raise "testing from work should have run the enclosing project"
    }

    null
  }
}
