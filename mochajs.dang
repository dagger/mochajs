"""
Toolchain to execute Mocha tests
"""
type Mochajs {
  """
  The base image to use.
  """
  baseImageAddress: String!

  """
  Package manager that installs dependencies. Empty detects it per project.
  """
  packageManager: String!

  """
  Run the package's build script before testing.
  """
  build: Boolean!

  """
  Extra flags passed to mocha.
  """
  flags: [String!]!

  """
  Extra arguments for the install command.
  """
  installFlags: [String!]!

  """
  Environment variables for Mocha, as KEY=VALUE.
  """
  environment: [String!]!

  """
  Seconds a Mocha run may take before it is stopped; 0 for no limit.
  """
  timeout: Int!

  new(
    """
    Base image for Mocha containers, e.g. "node:22".
    """
    baseImageAddress: String! = "node:25-alpine",
    """
    Package manager that installs dependencies: npm, yarn, pnpm or bun.
    Empty detects it from package.json's packageManager field, else the
    lockfile, else npm.
    """
    packageManager: String! = "",
    """
    Run the package's build script before testing.
    """
    build: Boolean! = false,
    """
    Extra flags passed to mocha, e.g. ["--exit"].
    """
    flags: [String!]! = [],
    """
    Extra arguments for the install command, e.g. ["--ignore-scripts"].
    """
    installFlags: [String!]! = [],
    """
    Environment variables for Mocha, as KEY=VALUE.
    """
    environment: [String!]! = [],
    """
    Seconds a Mocha run may take before it is stopped and fails; 0 for no
    limit.
    """
    timeout: Int! = 1800,
  ) {
    self.baseImageAddress = baseImageAddress
    self.packageManager = packageManager
    self.build = build
    self.flags = flags
    self.installFlags = installFlags
    self.environment = environment
    self.timeout = timeout
    self
  }

  """
  Filenames that mark a Mocha project. A `mocha` key in package.json also
  configures Mocha, but package.json marks every npm package, so it is not a
  discovery marker.
  """
  let configNames: [String!]! = [
    ".mocharc.js",
    ".mocharc.cjs",
    ".mocharc.mjs",
    ".mocharc.json",
    ".mocharc.jsonc",
    ".mocharc.yaml",
    ".mocharc.yml",
  ]

  """
  Mocha projects visible from the working directory, keyed by project root.
  """
  projects(ws: Workspace!): MochajsProjects! {
    MochajsProjects(paths: sorted(projectRoots(ws)), tool: self)
  }

  """
  Workspace-root-relative roots of the Mocha projects visible from the cwd:
  every project at or below it, plus the nearest enclosing project when the
  cwd is not a project root itself.
  """
  let projectRoots(ws: Workspace!): [String!]! {
    ws
      .findRoots(markers: configNames, exclude: ["**/node_modules/**"])
      .map { dir => workspaceRootPath(ws, dir) }
      .uniq
  }

  """
  Resolve a path relative to the caller's cwd, as findRoots returns them, into
  a workspace-root-relative one, collapsing any leading "..".
  """
  let workspaceRootPath(ws: Workspace!, cwdRelPath: String!): String! {
    let segments = cwdRelPath.split("/").filter { s => s != "" and s != "." }
    let up = segments.filter { s => s == ".." }.length
    let down = segments.filter { s => s != ".." }
    let resolved = ws.cwd.split("/").filter { s => s != "" }.dropLast(up) + down
    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  """
  Strings in byte order.
  """
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  """
  Two byte-ordered lists merged into one.
  """
  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }

  """
  A literal string as a JavaScript regular expression, for Mocha's --grep.
  """
  let quoteRegex(text: String!): String! {
    text.rewriteMatches(`[\\^$.|?*+()\[\]{}/-]`) { m => "\\" + m.string }
  }

  # Static reading of test files: only literal titles are honoured, and
  # nothing here runs a container or Node. Offsets are byte offsets, so the
  # source is made ASCII first. The scanning helpers come from the Jest
  # module.

  """
  A JS string literal: single, double, or backtick without interpolation.
  """
  let stringLiteral: String! = `'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*"|` + "`" + `(?:[^` + "`" + `$\\]|\\[\s\S])*` + "`"

  """
  A JS regex literal body and flags.
  """
  let regexLiteral: String! = `/(?:[^/\\\n\[*]|\\.|\[(?:[^\]\\\n]|\\.)*\])(?:[^/\\\n\[]|\\.|\[(?:[^\]\\\n]|\\.)*\])*/[a-z]*`

  """
  Comments, strings and regex literals: everything whose brackets are not
  code. A regex literal is recognized only after a character that can precede
  an expression, captured so masking keeps it.
  """
  let tokenPattern: String! {
    `//[^\n]*|/\*[\s\S]*?\*/|` + stringLiteral + `|([:\[,(=!&|?]\s*)` + regexLiteral
  }

  """
  A run of n filler characters.
  """
  let fill(n: Int!, char: String!): String! {
    "".padRight(n).replace(" ", char)
  }

  """
  Byte length of an ASCII string.
  """
  let size(text: String!): Int! { text.split("").length }

  """
  The source with comments, strings and regex literals replaced by filler of
  the same length, so offsets line up with the source while their brackets
  vanish.
  """
  let mask(source: String!): String! {
    source.rewriteMatches(Regexp(tokenPattern)) { m =>
      let lead = m.captures[0] ?? ""
      # Comments read as whitespace; literals as an opaque word.
      let char = if (m.string.hasPrefix("/")) { " " } else { "_" }
      lead + fill(m.end - m.start - size(lead), char)
    }
  }

  """
  A string literal's value, or null when text is anything else or holds an
  escape other than a quote or a backslash, which the source does not spell
  the way Mocha reports it.
  """
  let stringValue(text: String!): String {
    let m = text.trimSpace.match(Regexp(`^(?:'((?:[^'\\\n]|\\.)*)'|"((?:[^"\\\n]|\\.)*)"|` + "`" + `([^` + "`" + `$\\]*)` + "`" + `)$`))
    if (m == null) {
      return null
    }
    let raw = m.captures.join("")
    if (raw.containsMatch(Regexp(`\\[^'"\\` + "`" + `]`))) {
      return null
    }
    raw.replaceMatches(`\\(.)`, with: "$1")
  }

  """
  The key standing for the tests of a file that its source does not name.
  """
  let unnamedKey: String! = "*"

  """
  Suite and test functions of a Mocha interface, as regular expressions, or
  null for an interface whose titles this does not read (qunit, exports, or
  a custom one).
  """
  let interfaceCalls(ui: String!): {{suites: String!, tests: String!}} {
    if (ui == "bdd") {
      {{suites: "x?describe|x?context", tests: "x?it|x?specify"}}
    } else if (ui == "tdd") {
      {{suites: "suite", tests: "test"}}
    } else {
      null
    }
  }

  """
  The full titles a test file declares, as Mocha's --grep matches them: the
  literal titles of the enclosing suites and of the test, joined by spaces,
  in source order, with the number of test calls it cannot name and whether
  it calls .only. A test is named only when its title is a string literal and
  every scope around it is the file's top level, a plain block, or the
  callback of a named suite: a test in a helper function, a loop or forEach
  callback, a hook or another test is named by its caller at run time, and
  one under if or else, in a loop body, try, catch, switch or a ternary may
  not exist at all.
  """
  let testTitles(text: String!, ui: String!): {{titles: [String!]!, unnamed: Int!, only: Boolean!}}! {
    let calls = interfaceCalls(ui)
    let empty: [String!]! = []
    if (calls == null) {
      return {{titles: empty, unnamed: 1, only: false}}
    }
    let suites = calls!.suites
    let tests = calls!.tests
    let modifiers = `(?:\.(?:only|skip))*`
    let source = text.replaceMatches(`[^\x00-\x7F]`, with: "?")
    let masked = mask(source)
    # Titles are read from the source, where the literals survive, and paired
    # by offset with the calls found in the masked source, where brackets
    # inside strings and comments are gone and the nesting is sound.
    let literals = source
      .matchAll(Regexp(`\b(?:` + suites + "|" + tests + `)` + modifiers + `\s*\(\s*(` + stringLiteral + `)\s*[,)]`))
      .map { m =>
        let value = stringValue(m.captures[0] ?? "") ?? ""
        # A title prepare flattened is not the one Mocha reports.
        # A literal "*" would be the unnamed key's.
        let kept = if ((value.contains("?") and text.contains(value) == false) or value == unnamedKey) { "" } else { value }
        {{start: m.start, name: kept}}
      }
    let frames: [{{kind: String!, ok: Boolean!, prefix: [String!]!, before: String!}}!]! = []
    # The statement after one of these, or the block it opens, runs only
    # sometimes, if at all.
    let controlKeywords = ["if", "for", "while", "switch", "catch", "with"]
    let tokens = Regexp(
      `(=>\s*\{)|(\)\s*\{)|\b(else|try|finally|do)\s*\{|`
        # What comes right before a call: the ) of an if or a loop, else, do,
        # or a ternary's or a logical operator's operand.
        + `(\)\s*|\b(?:else|do)\s+|[?:]\s*|&&\s*|\|\|\s*)?`
        + `(\.\s*)?\b(?:(` + suites + `)|(` + tests + `)|([A-Za-z_$][\w$]*))` + modifiers + `\s*\(|[(){}]`,
    )
    let state = masked.matchAll(tokens).reduce({{stack: frames, out: empty, unnamed: 0}}) { st0, m =>
      let lead = m.captures[3] ?? ""
      # A ) before a call closes a paren first: the call is the statement of
      # an if or a loop when that paren was the condition's.
      let closing = lead.hasPrefix(")")
      let popped = if (closing) { st0.stack.takeLast(1)[0] } else { null }
      let st = if (closing) {
        {{stack: st0.stack.dropLast(1), out: st0.out, unnamed: st0.unnamed}}
      } else {
        st0
      }
      let conditional = lead != "" and (closing == false or controlKeywords.contains(if (popped == null) { "" } else { popped!.before }))
      let top = st.stack.takeLast(1)[0]
      let ok = (if (top == null) { true } else { top!.ok }) and conditional == false
      let prefix = if (top == null) { empty } else { top!.prefix }
      let arrow = m.captures[0] ?? ""
      let closeOpen = m.captures[1] ?? ""
      let keywordOpen = m.captures[2] ?? ""
      let dot = m.captures[4] ?? ""
      let suite = m.captures[5] ?? ""
      let test = m.captures[6] ?? ""
      let word = m.captures[7] ?? ""
      if (keywordOpen != "") {
        # else, try, finally and do blocks run only sometimes.
        {{
          stack: st.stack + [{{kind: "block", ok: false, prefix: prefix, before: ""}}],
          out: st.out,
          unnamed: st.unnamed,
        }}
      } else if (arrow != "") {
        # A function body: named only as a named suite's callback.
        let named = top != null and top!.kind == "suite" and ok
        {{
          stack: st.stack + [{{kind: "fn", ok: named, prefix: prefix, before: ""}}],
          out: st.out,
          unnamed: st.unnamed,
        }}
      } else if (closeOpen != "") {
        let rest = st.stack.dropLast(1)
        let closed = if (top == null) { "" } else { top!.before }
        let outer = rest.takeLast(1)[0]
        let outerOk = if (outer == null) { true } else { outer!.ok }
        let outerPrefix = if (outer == null) { empty } else { outer!.prefix }
        let frame = if (controlKeywords.contains(closed)) {
          # The block of an if, a loop, a switch or a catch.
          {{kind: "block", ok: false, prefix: outerPrefix, before: ""}}
        } else {
          # function (...) { or a method: a function body.
          let named = outer != null and outer!.kind == "suite" and outerOk
          {{kind: "fn", ok: named, prefix: outerPrefix, before: ""}}
        }
        {{stack: rest + [frame], out: st.out, unnamed: st.unnamed}}
      } else if (m.string == ")" or m.string == "}") {
        {{stack: st.stack.dropLast(1), out: st.out, unnamed: st.unnamed}}
      } else if (m.string == "{") {
        {{
          stack: st.stack + [{{kind: "block", ok: ok, prefix: prefix, before: ""}}],
          out: st.out,
          unnamed: st.unnamed,
        }}
      } else if (dot != "" or (suite == "" and test == "")) {
        # A member call such as names.forEach(, a plain call, or a paren.
        {{
          stack: st.stack + [{{kind: "paren", ok: false, prefix: prefix, before: word}}],
          out: st.out,
          unnamed: st.unnamed,
        }}
      } else {
        # The call starts after what came right before it.
        let start = m.start + size(lead)
        let name = literals.filter { l => l.start == start }.map { l => l.name }[0] ?? ""
        let named = ok and name != ""
        if (suite != "") {
          {{
            stack: st.stack + [{{kind: "suite", ok: named, prefix: prefix + [name], before: ""}}],
            out: st.out,
            unnamed: st.unnamed,
          }}
        } else {
          {{
            stack: st.stack + [{{kind: "test", ok: false, prefix: prefix, before: ""}}],
            out: if (named) { st.out + [(prefix + [name]).join(" ")] } else { st.out },
            unnamed: if (named) { st.unnamed } else { st.unnamed + 1 },
          }}
        }
      }
    }
    let only = masked.containsMatch(Regexp(`\b(?:` + suites + "|" + tests + `)(?:\.skip)*\.only\b`))
    {{titles: state.out.uniq, unnamed: state.unnamed, only: only}}
  }

  """
  Node container with every package manager's cache on a volume, corepack
  enabled for pnpm and yarn, and browser downloads and git hooks switched off:
  Mocha needs none of them.
  """
  let nodeBase(pm: String!): Container! {
    let base = container
      .from(baseImageAddress)
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withEnvVariable("npm_config_cache", "/root/.npm")
      # Concurrent Yarn 1 installs corrupt a shared cache.
      .withMountedCache("/root/.yarn-cache", cacheVolume("yarn-cache"), sharing: CacheSharingMode.LOCKED)
      .withEnvVariable("YARN_CACHE_FOLDER", "/root/.yarn-cache")
      .withMountedCache("/root/.bun-cache", cacheVolume("bun-cache"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun-cache")
      .withMountedCache("/root/.corepack", cacheVolume("corepack"))
      .withEnvVariable("COREPACK_HOME", "/root/.corepack")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD", "1")
      .withEnvVariable("PUPPETEER_SKIP_DOWNLOAD", "1")
      .withEnvVariable("CYPRESS_INSTALL_BINARY", "0")
      .withEnvVariable("HUSKY", "0")
      .withEnvVariable("SKIP_INSTALL_SIMPLE_GIT_HOOKS", "1")
    if (pm == "pnpm" or pm == "yarn") {
      # Images from node 25 on no longer ship corepack, and --force replaces
      # the yarn they still ship.
      let ctr = if (pm == "pnpm") {
        base
          .withMountedCache("/root/.pnpm-store", cacheVolume("pnpm-store"))
          # pnpm 12 ignores npm_config_store_dir, which npm warns about
          # anyway, so the install also passes --store-dir.
          .withEnvVariable("pnpm_config_store_dir", "/root/.pnpm-store")
      } else {
        base
      }
      ctr.withExec([
        "sh",
        "-c",
        "command -v corepack >/dev/null 2>&1 || npm install -g --force corepack; corepack enable",
      ])
    } else if (pm == "bun") {
      base.withExec(["sh", "-c", "command -v bun >/dev/null 2>&1 || npm install -g bun"])
    } else {
      base
    }
  }

  """
  Config filenames in the order Mocha looks for them.
  """
  let configLookupOrder: [String!]! = [
    ".mocharc.cjs",
    ".mocharc.js",
    ".mocharc.yaml",
    ".mocharc.yml",
    ".mocharc.jsonc",
    ".mocharc.json",
  ]

  """
  Workspace-root path of name inside dir.
  """
  let join(dir: String!, name: String!): String! {
    if (dir == ".") { name } else { dir + "/" + name }
  }

  """
  A workspace-root-relative path as an absolute one in the runner, which
  mirrors the workspace so that workspace-relative addresses resolve there.
  """
  let containerPath(p: String!): String! {
    if (p == ".") { "/src" } else { "/src/" + p }
  }

  """
  Strip leading and trailing slashes; the workspace root is ".".
  """
  let normalize(path: String!): String! {
    let p = path.trimPrefix("/").trimSuffix("/")
    if (p == "") { "." } else { p }
  }

  """
  path relative to dir, which contains it.
  """
  let relativeTo(dir: String!, path: String!): String! {
    if (path == dir) {
      "."
    } else if (dir == ".") {
      path
    } else {
      path.trimPrefix(dir + "/")
    }
  }

  """
  A relative path from dir, resolved to a workspace-root-relative one; ""
  when it is absolute or climbs above the root.
  """
  let within(dir: String!, rel: String!): String! {
    let empty: [String!]! = []
    # No segment can contain "/", so this marks a path that left the root.
    let invalid = ["/"]
    let start = if (dir == ".") { empty } else { dir.split("/") }
    let resolved = rel.split("/").reduce(start) { acc, segment =>
      if (acc == invalid) {
        acc
      } else if (segment == "" or segment == ".") {
        acc
      } else if (segment == "..") {
        if (acc.length == 0) { invalid } else { acc.dropLast(1) }
      } else {
        acc + [segment]
      }
    }
    if (rel.hasPrefix("/") or rel == "" or resolved == invalid) {
      ""
    } else if (resolved.length == 0) {
      "."
    } else {
      resolved.join("/")
    }
  }

  let depth(dir: String!): Int! {
    if (dir == ".") { 0 } else { dir.split("/").length }
  }

  """
  Directory of a workspace path returned by findUp, or null.
  """
  let dirOf(found: String): String {
    if (found == null) {
      null
    } else {
      normalize((found ?? "").split("/").dropLast(1).join("/"))
    }
  }

  """
  The deepest, so nearest, of the given directories on one path, or null.
  """
  let nearest(dirs: [String]!): String {
    let none: String = null
    dirs.reduce(none) { best, dir =>
      if (dir == null) {
        best
      } else if (best == null) {
        dir
      } else if (depth(dir ?? ".") > depth(best ?? ".")) {
        dir
      } else {
        best
      }
    }
  }

  """
  The pinned image the module's own helpers run in, never the project's: it
  builds the instrumentation and runs the report indexer.
  """
  let helperImage: String! = "oven/bun:1.3.0-alpine@sha256:37e6b1cbe053939bccf6ae4507977ed957eaa6e7f275670b72ad6348e0d2c11f"

  """
  The script that reads one shared Mocha run's JSON report and writes one
  bounded result per selected test file. It needs no dependency.
  """
  let reportIndexer: File! {
    currentModule.source.file("helpers/report-indexer.cjs")
  }

  """
  The OpenTelemetry instrumentation for Mocha, built from this repository with
  its runtime dependencies, preloaded from where it is mounted rather than
  installed into the project.
  """
  let library: Directory! {
    # `tests` holds vendored checkouts that dwarf the library itself
    let module = currentModule.source.filter(
      exclude: ["tests", ".dagger", "dist", "node_modules", "helpers", "mochajs.dang"],
    )

    container
      .from(helperImage)
      .withMountedCache("/root/.bun/install/cache", cacheVolume("library-node-modules"))
      .withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.bun/install/cache")
      .withDirectory("/src", module)
      .withWorkdir("/src")
      .withExec(["bun", "install"])
      .withExec(["bun", "run", "build"])
      .withExec(["rm", "-rf", "node_modules"])
      # Mocha is a peer: the instrumentation patches the project's own, so the
      # library must not bring one.
      .withExec(["bun", "install", "--production", "--omit=peer"])
      .directory("/src")
      .filter(include: ["dist", "node_modules", "package.json"])
  }
}

# Keep all Dang types in one source file until Dagger v0.21.x can
# convert Workspace arguments for installed multi-file Dang toolchains.
# See dagger/dagger#13476.

"""
Mocha projects in a workspace, keyed by project root.
"""
type MochajsProjects @collection {
  """
  Project root paths, relative to the workspace root.
  """
  paths: [String!]! @keys

  """
  Settings every project is tested with.
  """
  let tool: Mochajs!

  """
  The Mocha project rooted at path.
  """
  project(path: String!): MochajsProject! @get {
    MochajsProject(path: path, tool: tool)
  }

  """
  Run tests in the selected Mocha projects.
  """
  test(ws: Workspace!): Void {
    # A selection over a list evaluates its elements concurrently, so all
    # project test runs happen in parallel.
    let failures = paths.map { p => project(p) }.{{path, failure: testFailure(ws, [], "")}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Mocha failed in " + toString(failures.length) + " project(s):\n"
        + failures.map { result => "- " + result.path + ": " + (result.failure ?? "") }.join("\n")
    }
    null
  }
}

"""
A Mocha project rooted at a workspace-relative path.
"""
type MochajsProject {
  """
  Project root, relative to the workspace.
  """
  path: String!

  """
  Settings this project is tested with.
  """
  let tool: Mochajs!

  """
  Test files in this project, keyed by project-relative path. They are found
  from the source alone, with no container, so listing them never installs
  dependencies or runs Mocha. A project whose discovery fails keeps one key,
  its Mocha config, whose check fails with the reason; every other project is
  unaffected.
  """
  testFiles(ws: Workspace!): MochajsTestFiles! {
    let failure = discoveryFailure(ws)
    let empty: [String!]! = []
    if (failure != null) {
      let name = configName(ws)
      MochajsTestFiles(
        files: [name],
        project: self,
        discoveryError: failure,
        entries: [fileEntry(name, empty, [tool.unnamedKey], false)],
      )
    } else {
      let files = testFilePaths(ws)
      let ui = interfaceName(ws)
      let filter = userFilter(ws)
      MochajsTestFiles(
        files: files,
        project: self,
        discoveryError: null,
        entries: files.map { file =>
          let found = tool.testTitles(ws.file("/" + globPrefix + file).contents, ui)
          # The settings' --grep, and the config's, exclude tests Mocha would
          # never run, so they are no keys.
          let kept = found.titles.filter { title => keeps(filter, title) }
          let rest = if (found.unnamed > 0 or found.titles.length == 0) { [tool.unnamedKey] } else { empty }
          fileEntry(file, found.titles, kept + rest, found.only)
        },
      )
    }
  }

  let fileEntry(file: String!, statics: [String!]!, keys: [String!]!, only: Boolean!): MochajsTestFileSelection! {
    MochajsTestFileSelection(
      path: file,
      tests: MochajsTests(titles: keys, statics: statics, only: only, path: file, project: self),
    )
  }

  """
  Whether Mocha fails a run that uses .only: --forbid-only in the settings'
  flags, or forbidOnly in the config.
  """
  let forbidsOnly(ws: Workspace!): Boolean! {
    let text = configText(ws) ?? ""
    let configured = { (YAML.decode(text) :: {{forbidOnly: Boolean}}!).forbidOnly ?? false } rescue {
      err: Error => false
    }
    tool.flags.contains("--forbid-only") or configured
  }

  """
  The Mocha interface the project's tests are written in: the settings'
  --ui, else the config's ui, else bdd. Empty when the config is JavaScript,
  whose ui this cannot read.
  """
  let interfaceName(ws: Workspace!): String! {
    let flag = flagValue(["--ui", "-u"])
    if (flag != "") {
      flag
    } else if (configName(ws).hasSuffix("js")) {
      ""
    } else {
      let text = configText(ws) ?? ""
      let configured = { (YAML.decode(text) :: {{ui: String}}!).ui ?? "" } rescue {
        err: Error => ""
      }
      if (configured == "") { "bdd" } else { configured }
    }
  }

  """
  The value of the first of the named flags in the settings' flags, or "".
  """
  let flagValue(names: [String!]!): String! {
    tool.flags.reduce({{prev: "", value: ""}}) { st, arg =>
      let joined = names.filter { n => n.hasPrefix("--") and arg.hasPrefix(n + "=") }
      if (st.value != "") {
        st
      } else if (names.contains(st.prev)) {
        {{prev: "", value: arg}}
      } else if (joined.length > 0) {
        {{prev: "", value: arg.trimPrefix(joined[0]! + "=")}}
      } else {
        {{prev: arg, value: ""}}
      }
    }.value
  }

  """
  The test filter Mocha applies on its own: the settings' --grep, --fgrep
  and --invert, else the config's grep, fgrep and invert.
  """
  let userFilter(ws: Workspace!): {{grep: String!, fgrep: String!, invert: Boolean!}}! {
    let text = configText(ws) ?? ""
    let configGrep = { (YAML.decode(text) :: {{grep: String}}!).grep ?? "" } rescue { err: Error => "" }
    let configFgrep = { (YAML.decode(text) :: {{fgrep: String}}!).fgrep ?? "" } rescue { err: Error => "" }
    let configInvert = { (YAML.decode(text) :: {{invert: Boolean}}!).invert ?? false } rescue { err: Error => false }
    let flagGrep = flagValue(["--grep", "-g"])
    let flagFgrep = flagValue(["--fgrep", "-f"])
    let anyFlag = flagGrep != "" or flagFgrep != ""
    let pattern = if (anyFlag) { flagGrep } else { configGrep }
    # Mocha also takes --grep as /pattern/flags; the flags cannot be kept.
    let slashed = pattern.match(`^/(.*)/[gimsuy]*$`)
    {{
      grep: if (slashed == null) { pattern } else { slashed!.captures[0] ?? "" },
      fgrep: if (anyFlag) { flagFgrep } else { configFgrep },
      invert: tool.flags.contains("--invert") or tool.flags.contains("-i") or configInvert,
    }}
  }

  """
  Whether Mocha's own filter keeps a test with this full title. A pattern
  Go cannot compile keeps every title.
  """
  let keeps(filter: {{grep: String!, fgrep: String!, invert: Boolean!}}!, title: String!): Boolean! {
    let matched = if (filter.fgrep != "") {
      title.contains(filter.fgrep)
    } else if (filter.grep != "") {
      { title.containsMatch(Regexp(filter.grep)) } rescue {
        err: Error => filter.invert == false
      }
    } else {
      true
    }
    if (filter.grep == "" and filter.fgrep == "") { true } else { matched != filter.invert }
  }

  """
  Mocha's own filter as a lookahead at the start of a full title, so it can
  join a --grep that replaces it.
  """
  let userCondition(ws: Workspace!): String! {
    let filter = userFilter(ws)
    let pattern = if (filter.fgrep != "") { tool.quoteRegex(filter.fgrep) } else { filter.grep }
    if (pattern == "") {
      ""
    } else if (filter.invert) {
      "(?![\\s\\S]*?(?:" + pattern + "))"
    } else {
      "(?=[\\s\\S]*?(?:" + pattern + "))"
    }
  }

  """
  The settings' flags without Mocha's test filter, which a --grep of the
  module's own replaces.
  """
  let unfilteredFlags: [String!]! {
    let empty: [String!]! = []
    tool.flags.reduce({{skip: false, out: empty}}) { st, arg =>
      if (st.skip) {
        {{skip: false, out: st.out}}
      } else if (["--grep", "-g", "--fgrep", "-f"].contains(arg)) {
        {{skip: true, out: st.out}}
      } else if (arg.hasPrefix("--grep=") or arg.hasPrefix("--fgrep=") or arg == "--invert" or arg == "-i") {
        {{skip: false, out: st.out}}
      } else {
        {{skip: false, out: st.out + [arg]}}
      }
    }.out
  }

  """
  One anchored --grep over the selected tests, or "" when the selection
  needs none: the sorted titles of the selected named tests, and for each
  file whose unnamed tests are selected, every title but that file's named
  ones. Mocha's own filter joins it as a lookahead.
  """
  let grepFor(ws: Workspace!, selected: [MochajsTestSelection!]!): String! {
    let empty: [String!]! = []
    let named = tool.sorted(
      selected.reduce(empty) { acc, s => acc + s.keys.filter { k => k != tool.unnamedKey } }.uniq,
    )
    let rest = tool.sorted(
      selected
        .filter { s => s.keys.contains(tool.unnamedKey) }
        .map { s =>
          if (s.statics.length == 0) { "" } else {
            "(?!(?:" + s.statics.map { t => tool.quoteRegex(t) }.join("|") + ")$)"
          }
        }
        .uniq,
    )
    if (rest.contains("")) {
      # Some file's unnamed tests are all of its tests: everything matches,
      # so Mocha's own filter is left to apply as it is.
      ""
    } else {
      let alternatives = (if (named.length == 0) { empty } else {
        ["(?:" + named.map { t => tool.quoteRegex(t) }.join("|") + ")$"]
      }) + rest
      "^" + userCondition(ws) + "(?:" + alternatives.join("|") + ")"
    }
  }

  """
  Why this project's test files cannot be found, naming the file, or null:
  a JSON or YAML Mocha config that does not parse, or a search that fails.
  """
  let discoveryFailure(ws: Workspace!): String {
    let name = configName(ws)
    let text = configText(ws)
    let config = if (text == null) {
      null
    } else if (name.hasSuffix(".yaml") or name.hasSuffix(".yml")) {
      { YAML.decode(text ?? "") :: {{}}!; null } rescue {
        err: Error => "cannot read " + tool.join(path, name) + ": " + err.message
      }
    } else {
      { JSON.decode(text ?? "") :: {{}}!; null } rescue {
        err: Error => "cannot read " + tool.join(path, name) + ": " + err.message
      }
    }
    if (config != null) {
      config
    } else {
      { testFilePaths(ws); null } rescue {
        err: Error => "cannot search " + path + " for test files: " + err.message
      }
    }
  }

  """
  Run this project's tests.
  """
  test(ws: Workspace!): Void {
    let empty: [String!]! = []
    let failure = testFailure(ws, empty, "")
    if (failure != null) {
      raise "Mocha failed in " + path + ": " + (failure ?? "")
    }
    null
  }

  """
  List the tests of this project, as mocha --dry-run reports them. A plain
  function: listing checks never calls it.
  """
  list(ws: Workspace!): String! {
    let ran = dryRun(ws, [])
    let failure = toolFailure(ran, "mocha --dry-run")
    if (failure != null) {
      raise "Mocha failed in " + path + ": " + (failure ?? "")
    }
    ran.stdout
  }

  """
  The source directory of this project.
  """
  source(ws: Workspace!): Directory! {
    ws.directory(absolutePath, exclude: ["**/node_modules"], gitignore: true)
  }

  """
  The project root as an absolute workspace path, which every Workspace API
  resolves against the workspace root.
  """
  let absolutePath: String! {
    if (path == ".") { "/" } else { "/" + path }
  }

  """
  Prefix turning a project-relative path into a workspace-root-relative one.
  """
  let globPrefix: String! {
    if (path == ".") { "" } else { path + "/" }
  }

  """
  Why this project's tests failed, naming the step, or null when they pass:
  the whole project when files is empty, else only the named files, narrowed
  by grep when it is not empty. It never raises, so testing every project
  reports every failing one.
  """
  let testFailure(ws: Workspace!, files: [String!]!, grep: String!): String {
    {
      let install = installFailure(ws)
      if (install != null) { install } else { toolFailure(testExec(ws, files, grep), "mocha") }
    } rescue {
      err: Error => err.message
    }
  }

  """
  Run the given test files, narrowed by grep when it is not empty, naming
  this project when they fail.
  """
  let runFiles(ws: Workspace!, files: [String!]!, grep: String!): Void {
    let failure = testFailure(ws, files, grep)
    if (failure != null) {
      raise "Mocha failed in " + path + ": " + (failure ?? "")
    }
    null
  }

  """
  Container that has run this project's tests: the whole project, as its own
  Mocha config selects them, when files is empty, else only the named files.
  """
  let testExec(ws: Workspace!, files: [String!]!, grep: String!): Container! {
    let empty: [String!]! = []
    testEnv(ws, grep).withExec(
      mocha(ws, mochaArgs(files, grep, empty)),
      daggerInDaggerNewSession: true,
      expect: ReturnType.ANY,
    )
  }

  """
  Mocha's arguments for only the named files: the project's config without
  its spec, which Mocha would add to the files named on the command line,
  and with a --grep of the module's own in place of Mocha's filter when grep
  is not empty.
  """
  let filesArgs(grep: String!): [String!]! {
    let base = ["--config", filesConfigPath, "--no-package"]
    if (grep == "") { base + tool.flags } else { base + unfilteredFlags + ["--grep", grep] }
  }

  """
  Mocha's arguments: the whole project, as its own Mocha config selects it,
  when files is empty, else only the named files. extra comes before the
  files.
  """
  let mochaArgs(files: [String!]!, grep: String!, extra: [String!]!): [String!]! {
    if (files.length == 0) { tool.flags + extra } else { filesArgs(grep) + extra + files }
  }

  """
  Where the shared run writes Mocha's report and output, and where the run
  that takes each file alone writes its own.
  """
  let reportPath: String! = "/dagger-mocha/report.json"
  let stdoutPath: String! = "/dagger-mocha/stdout.log"
  let stderrPath: String! = "/dagger-mocha/stderr.log"
  let eachScriptPath: String! = "/dagger-mocha/each.sh"
  let eachPath: String! = "/dagger-mocha/each"

  """
  One Mocha run and report shared by every selected test file of this
  project. Everything here depends only on the workspace and the selection,
  never on the check asking, so every check of the project builds the same
  command and Dagger runs it once.
  """
  let runTests(ws: Workspace!, selection: MochajsTestFiles!): MochajsTestResults! {
    if (selection.discoveryError != null) {
      raise "Mocha failed in " + path + ": " + (selection.discoveryError ?? "")
    }
    let discovered = selection
      .entries
      .filter { entry => selection.files.contains(entry.path) }
      .map { entry =>
        MochajsTestSelection(
          file: entry.path,
          keys: entry.tests.titles,
          statics: entry.tests.statics,
          only: entry.tests.only,
          narrowed: entry.tests.narrowed,
        )
      }
    # In key order, which discovery sorted and a selection keeps.
    let selected = discovered.filter { s => s.keys.length > 0 }
    if (selected.length == 0) {
      raise "no tests selected in Mocha project " + path
    }
    let install = installFailure(ws)
    if (install != null) {
      raise "Mocha failed in " + path + ": " + (install ?? "")
    }
    let empty: [String!]! = []
    let narrowedTests = discovered.any { s => s.narrowed }
    # With nothing selected out anywhere, run the project as its Mocha config
    # selects it. Without a delta, naming the files is the safe choice.
    let whole = selection.narrowed == false and narrowedTests == false
    let files = selected.map { s => s.file }
    let named = if (whole) { empty } else { files }
    # Every check of the project evaluates this, so titles are only gathered
    # for the run that needs them.
    let grep = if (narrowedTests) { grepFor(ws, selected) } else { "" }
    let executed = testEnv(ws, grep).withExec(
      mocha(ws, mochaArgs(named, grep, ["--reporter", "json", "--reporter-option", "output=" + reportPath])),
      daggerInDaggerNewSession: true,
      expect: ReturnType.ANY,
      redirectStdout: stdoutPath,
      redirectStderr: stderrPath,
    )
    let code = executed.exitCode
    let shared = executed
      .directory("/dagger-mocha")
      .filter(include: ["report.json", "stdout.log", "stderr.log"])
    # A .only in any file of the run leaves Mocha's other tests out, and
    # Mocha passes the run; under forbidOnly, Mocha fails it instead.
    let only = forbidsOnly(ws) == false
    let first = index(selected, shared, code, "shared", only)
    # Mocha loads every file before it runs one, so a file that throws while
    # loading stops the whole run with no report. Only then, run each
    # selected file alone, in one more shared run, so the file that broke
    # fails and the others report their own tests.
    let results = if (first.glob("aborted").length == 0) {
      first
    } else {
      let each = testEnv(ws, grep)
        .withNewFile(eachScriptPath, eachScript)
        .withExec(
          ["sh", eachScriptPath, eachPath] + files + ["--"] + mocha(ws, filesArgs(grep)),
          daggerInDaggerNewSession: true,
          expect: ReturnType.ANY,
        )
      index(selected, shared.withDirectory("each", each.directory(eachPath)), code, "each", only)
    }
    MochajsTestResults(results: results, selections: selected, project: path)
  }

  """
  One result per selected test, by the positions of its file and its key in
  the selection, written by the
  report indexer in its own pinned image from the run's report and output.
  """
  let index(selected: [MochajsTestSelection!]!, inputs: Directory!, code: Int!, mode: String!, onlyAllowed: Boolean!): Directory! {
    let header = if (code == 124) {
      timeoutFailure("mocha")
    } else {
      "mocha failed (exit " + toString(code) + ")"
    }
    container
      .from(tool.helperImage)
      .withFile("/usr/local/lib/report-indexer.cjs", tool.reportIndexer)
      .withDirectory("/in", inputs)
      .withNewFile(
        "/in/selection.json",
        JSON.encode(selected.map { s => {{file: s.file, keys: s.keys, statics: s.statics, only: s.only}} }),
      )
      .withExec([
        "bun", "/usr/local/lib/report-indexer.cjs",
        "--mode", mode,
        "--only-allowed", if (onlyAllowed) { "true" } else { "false" },
        "--in", "/in",
        "--exit-code", toString(code),
        "--header", header,
        "--prefix", tool.containerPath(path) + "/",
        "--out", "/out",
      ])
      .directory("/out")
  }

  """
  Run each test file named before "--" alone with the command after it,
  writing <dir>/<position>.json, .log and .code for each.
  """
  let eachScript: String! =
    "out=$1\nshift\nn=0\n"
      + "while [ \"$1\" != \"--\" ]; do eval \"f_$n=\\$1\"; n=$((n+1)); shift; done\n"
      + "shift\nmkdir -p \"$out\"\ni=0\n"
      + "while [ \"$i\" -lt \"$n\" ]; do\n"
      + "  eval \"f=\\$f_$i\"\n"
      + "  \"$@\" --reporter json --reporter-option \"output=$out/$i.json\" \"$f\" >\"$out/$i.log\" 2>&1\n"
      + "  echo \"$?\" >\"$out/$i.code\"\n"
      + "  i=$((i+1))\n"
      + "done\n"

  """
  The runner, ready to run Mocha's tests. Nothing in it changes from one
  run to the next, so unchanged inputs reuse the cached result.
  """
  let testEnv(ws: Workspace!, grep: String!): Container! {
    let base = runner(ws).withNewFile(filesConfigPath, filesConfig)
    # With a --grep of the module's own, the config's filter must not join or
    # invert it.
    (if (grep == "") { base } else { base.withEnvVariable("DAGGER_MOCHA_OWN_GREP", "1") })
      # A test that uses a Dagger SDK opens a session from inside this
      # container, and a session finds its workspace root by walking up to a
      # .git directory. Without one it gets an empty workspace, so every
      # workspace-relative API fails there -- including the serveModule a
      # generated module client calls before its first query. The marker only
      # has to exist, so synthesize an empty one rather than uploading the real
      # git directory; a workspace built from a Directory has none to upload.
      .withDirectory("/src/.git", directory)
      # With its own session rather than the one running Mocha, a module
      # address resolves against the user's workspace instead of against this
      # module. The engine mounts a version-matched CLI on PATH for it, which a
      # TypeScript client on SDK v1.0.4 or later finds by itself; an older one
      # only reads _EXPERIMENTAL_DAGGER_CLI_BIN, so keep setting it until those
      # are out of support.
      .withEnvVariable("_EXPERIMENTAL_DAGGER_CLI_BIN", "/dev/.dagger/dagger")
  }

  let timeoutFailure(step: String!): String! {
    step + " did not finish within " + toString(tool.timeout)
      + "s. If its tests had finished and the process kept running, something left a handle open (a server, a connection, a timer): set flags to [\"--exit\"], or exit: true in the Mocha config. Otherwise raise the timeout setting."
  }

  """
  Why a Mocha run failed, with the end of its output, or null.
  """
  let toolFailure(ran: Container!, step: String!): String {
    let code = ran.exitCode
    if (code == 0) {
      null
    } else if (code == 127) {
      ran.stderr.trim(" \n")
    } else if (code == 124) {
      timeoutFailure(step)
    } else {
      let output = (ran.stdout.trim(" \n") + "\n" + ran.stderr.trim(" \n")).trim(" \n")
      step + " failed (exit " + toString(code) + "):\n" + output.split("\n").takeLast(15).join("\n")
    }
  }

  """
  Where the config that runs only the named files is mounted.
  """
  let filesConfigPath: String! = "/dagger-mocha/mocharc.cjs"

  """
  A Mocha config that loads the project's own config the way Mocha would,
  through Mocha's own loaders (lib/cli/options in Mocha 9-11, options.cjs in
  Mocha 12), minus its spec. Mocha adds the configured spec to any files named
  on the command line, so running only the named files means dropping it.
  """
  let filesConfig: String! = ```
  const paths = [process.cwd()];
  // Mocha 12 is ESM and names its CommonJS internals .cjs, which require does
  // not try on its own; Mocha 9-11 ship lib/cli/options.js.
  const optionsPath = (() => {
    try {
      return require.resolve("mocha/lib/cli/options.cjs", { paths });
    } catch {
      return require.resolve("mocha/lib/cli/options", { paths });
    }
  })();
  const { loadRc, loadPkgRc } = require(optionsPath);
  const rc = loadRc() || {};
  const pkg = loadPkgRc() || {};
  const config = { ...pkg };
  for (const [key, value] of Object.entries(rc)) {
    config[key] = Array.isArray(value) && Array.isArray(config[key]) ? [...config[key], ...value] : value;
  }
  delete config.spec;
  delete config._;
  if (process.env.DAGGER_MOCHA_OWN_GREP === "1") {
    delete config.grep;
    delete config.fgrep;
    delete config.invert;
  }
  module.exports = config;
  ```

  """
  The Mocha command: npx without a package.json, otherwise the wrapper the
  runner installs, which runs the project's own Mocha. Both run under the
  timeout.
  """
  let mocha(ws: Workspace!, args: [String!]!): [String!]! {
    let command = if (installRoot(ws) == null) { ["npx", "--yes", "mocha"] } else { ["mocha"] }
    ["sh", "/dagger-mocha/timeout.sh"] + command + args
  }

  """
  Run a command, stopping it after DAGGER_MOCHA_TIMEOUT seconds (0: never)
  with exit code 124.
  """
  let timeoutScript: String! =
    "if [ \"$DAGGER_MOCHA_TIMEOUT\" -gt 0 ]; then\n"
      + "  timeout -k 10 \"$DAGGER_MOCHA_TIMEOUT\" \"$@\"\n"
      + "  status=$?\n"
      + "  if [ \"$status\" -eq 124 ] || [ \"$status\" -eq 143 ]; then\n"
      + "    echo \"mocha did not finish within $DAGGER_MOCHA_TIMEOUT seconds\" >&2\n"
      + "    exit 124\n"
      + "  fi\n"
      + "  exit \"$status\"\n"
      + "fi\n"
      + "exec \"$@\"\n"

  # 124 from coreutils' timeout, 143 (SIGTERM) from busybox's.

  """
  A mocha command that runs the nearest node_modules/.bin/mocha between the
  working directory and the install root, or yarn's under Plug'n'Play, and
  says how to fix it when there is none.
  """
  let wrapper(root: String!): String! {
    "#!/bin/sh\n"
      + "d=\"$PWD\"\n"
      + "while :; do\n"
      + "  if [ -x \"$d/node_modules/.bin/mocha\" ]; then exec \"$d/node_modules/.bin/mocha\" \"$@\"; fi\n"
      + "  if [ \"$d\" = " + tool.containerPath(root) + " ] || [ \"$d\" = / ]; then break; fi\n"
      + "  d=$(dirname \"$d\")\n"
      + "done\n"
      + "if [ -f " + tool.containerPath(root) + "/.pnp.cjs ]; then exec yarn mocha \"$@\"; fi\n"
      + "echo \"mocha is not installed: add it to the devDependencies of "
      + tool.join(root, "package.json")
      + " (or of a package.json between it and the project)\" >&2\n"
      + "exit 127\n"
  }

  """
  Where dependencies are installed: the nearest workspace root at or above
  this project (pnpm-workspace.yaml, or a package.json with "workspaces"),
  else the nearest lockfile's directory, else the nearest package.json's.
  Null when there is no package.json at or above the project.
  """
  let installRoot(ws: Workspace!): String {
    let from = absolutePath
    if (ws.findUp("package.json", from) == null) {
      null
    } else {
      let workspaceRoot = tool.nearest([
        tool.dirOf(ws.findUp("pnpm-workspace.yaml", from)),
        workspacesRoot(ws, from),
      ])
      let lockRoot = tool.nearest(
        lockfiles.map { name => tool.dirOf(ws.findUp(name, from)) },
      )
      workspaceRoot ?? lockRoot ?? tool.dirOf(ws.findUp("package.json", from))
    }
  }

  let lockfiles: [String!]! = [
    "pnpm-lock.yaml",
    "yarn.lock",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "bun.lock",
    "bun.lockb",
  ]

  """
  The nearest directory at or above from whose package.json declares
  "workspaces", or null.
  """
  let workspacesRoot(ws: Workspace!, from: String!): String {
    let found = ws.findUp("package.json", from)
    if (found == null) {
      null
    } else {
      let dir = tool.dirOf(found) ?? "."
      if (ws.file(found ?? "").contents.contains("\"workspaces\"")) {
        dir
      } else if (dir == ".") {
        null
      } else {
        workspacesRoot(ws, "/" + (tool.dirOf("/" + dir) ?? "."))
      }
    }
  }

  """
  The configured package manager, else the one root's package.json names in
  "packageManager", else the one its lockfile belongs to, else npm.
  """
  let packageManager(ws: Workspace!, root: String!): String! {
    if (tool.packageManager != "") {
      tool.packageManager
    } else {
      let text = { ws.file("/" + tool.join(root, "package.json")).contents } rescue {
        err: Error => ""
      }
      let declared = if (text.contains("\"packageManager\"")) {
        text.replaceMatches(`(?s)^.*"packageManager"\s*:\s*"([a-zA-Z]+)@.*$`, with: "$1")
      } else {
        ""
      }
      if (["npm", "pnpm", "yarn", "bun"].contains(declared)) {
        declared
      } else if (has(ws, root, "pnpm-lock.yaml") or has(ws, root, "pnpm-workspace.yaml")) {
        "pnpm"
      } else if (has(ws, root, "yarn.lock")) {
        "yarn"
      } else if (has(ws, root, "bun.lock") or has(ws, root, "bun.lockb")) {
        "bun"
      } else {
        "npm"
      }
    }
  }

  let has(ws: Workspace!, dir: String!, name: String!): Boolean! {
    ws.findUp(name, "/" + dir) == "/" + tool.join(dir, name)
  }

  """
  Everything the install reads, and nothing else, so editing source files
  does not re-run it: the manifests, lockfiles and package manager config,
  plus the directories that file:, link: and portal: dependencies and pnpm's
  injected workspace packages point at, which the install copies, and the
  "bin" files it links. When those
  cannot be worked out, the whole source, so the install is still right.
  """
  let installInputs(ws: Workspace!, root: String!): Directory! {
    let local = localDependencies(ws, root)
    if (local == null) {
      ws.directory("/" + root, exclude: ["**/node_modules", ".git"], gitignore: true)
    } else {
      let empty: [String!]! = []
      ws.directory(
        "/" + root,
        include: [
          "**/package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          ".pnpmfile.cjs",
          "yarn.lock",
          ".yarnrc",
          ".yarnrc.yml",
          ".yarn/releases/**",
          ".yarn/plugins/**",
          ".yarn/patches/**",
          "package-lock.json",
          "npm-shrinkwrap.json",
          "bun.lock",
          "bun.lockb",
          "bunfig.toml",
          "**/.npmrc",
          "patches/**",
        ]
          + (local ?? empty).reduce(empty) { acc, dir => acc + [dir, dir + "/**"] },
        exclude: ["**/node_modules"],
      )
    }
  }

  """
  The package.json files below the install root, relative to it, found with
  one search that skips node_modules.
  """
  let manifests(ws: Workspace!, root: String!): [String!]! {
    ws
      .search(
        paths: ["/" + root],
        globs: ["package.json", "!node_modules", "!.git"],
        pattern: "",
        filesOnly: true,
      ).{{filePath}}
      .map { found =>
        tool.relativeTo(
          root,
          tool.normalize(found.filePath.trimPrefix("./")),
        )
      }
  }

  """
  Root-relative paths that the install root's file:, link: and portal:
  dependencies, overrides and resolutions point at, the directories of
  workspace packages pnpm injects, and the files packages name in "bin", which
  the install links into node_modules/.bin. Null when a manifest is not valid
  JSON, or a dependency path cannot be placed inside the install root.
  """
  let localDependencies(ws: Workspace!, root: String!): [String!] {
    {
      let empty: [String!]! = []
      # One read per manifest, tagged: "path:" a local dependency, "package:"
      # a package's name and directory, "injected:" a package pnpm injects.
      let facts = manifests(ws, root).reduce(empty) { acc, file =>
        let dir = tool.normalize(file.split("/").dropLast(1).join("/"))
        let text = ws.file("/" + tool.join(root, file)).contents
        let manifest = JSON.decode(text) :: {{name: String}}!
        let paths = text.matchAll(`"(?:file|link|portal):([^"]*)"`).map { m =>
          "path:" + tool.within(dir, m.captures.takeFirst(1).join(""))
        }
        let injected = text.matchAll(`"([^"]+)"\s*:\s*\{\s*"injected"\s*:\s*true`).map { m =>
          "injected:" + m.captures.takeFirst(1).join("")
        }
        # "bin" is a path, or an object of command names to paths.
        let binField = text.matchAll(`"bin"\s*:\s*("[^"]*"|\{[^}]*\})`).map { m =>
          m.captures.takeFirst(1).join("")
        }.takeFirst(1).join("")
        let bins = binField.matchAll(`"([^"]*)"\s*(?:,|\}|$)`).map { m =>
          "bin:" + tool.within(dir, m.captures.takeFirst(1).join(""))
        }
        acc + paths + injected + bins + ["package:" + (manifest.name ?? "") + "=" + dir]
      }
      let packages = facts.filter { f => f.hasPrefix("package:") }.map { f => f.trimPrefix("package:") }
      let injectedDirs = facts
        .filter { f => f.hasPrefix("injected:") }
        .map { f => f.trimPrefix("injected:") + "=" }
        .reduce(empty) { acc, prefix =>
          acc + packages.filter { p => p.hasPrefix(prefix) }.map { p => p.trimPrefix(prefix) }
        }
      let paths = facts.filter { f => f.hasPrefix("path:") }.map { f => f.trimPrefix("path:") }
        + injectedDirs
      # A bin outside the install root is not needed to link the others.
      let bins = facts
        .filter { f => f.hasPrefix("bin:") }
        .map { f => f.trimPrefix("bin:") }
        .filter { f => f != "" and f != "." }
      if (paths.contains("") or paths.contains(".")) { null } else { (paths + bins).uniq }
    } rescue {
      err: Error => null
    }
  }

  """
  The install command. pnpm keeps its store on the cache volume, and pnpm
  and Yarn freeze the lockfile under CI, which fails when there is none to
  freeze, so that case opts out.
  """
  let installCommand(ws: Workspace!, root: String!): [String!]! {
    let pm = packageManager(ws, root)
    let empty: [String!]! = []
    let store = if (pm == "pnpm") { ["--store-dir", "/root/.pnpm-store"] } else { empty }
    let unfrozen = if (pm == "pnpm" and has(ws, root, "pnpm-lock.yaml") == false) {
      ["--no-frozen-lockfile"]
    } else {
      empty
    }
    [pm, "install"] + store + unfrozen + tool.installFlags
  }

  """
  The install root with its dependencies installed. The install may have
  failed: read exitCode.
  """
  let installed(ws: Workspace!, root: String!): Container! {
    tool
      .nodeBase(packageManager(ws, root))
      .withDirectory(tool.containerPath(root), installInputs(ws, root))
      .withWorkdir(tool.containerPath(root))
      .withEnvVariable(
        "YARN_ENABLE_IMMUTABLE_INSTALLS",
        if (has(ws, root, "yarn.lock")) { "true" } else { "false" },
      )
      .withExec(installCommand(ws, root), expect: ReturnType.ANY)
  }

  """
  Why installing dependencies failed, with the end of its output, or null.
  """
  let installFailure(ws: Workspace!): String {
    let root = installRoot(ws)
    if (root == null) {
      null
    } else {
      let ran = installed(ws, root ?? ".")
      let code = ran.exitCode
      if (code == 0) {
        null
      } else {
        let output = (ran.stdout.trim(" \n") + "\n" + ran.stderr.trim(" \n")).trim(" \n")
        "install failed (" + installCommand(ws, root ?? ".").join(" ") + ", exit " + toString(code)
          + "):\n" + output.split("\n").takeLast(15).join("\n")
      }
    }
  }

  """
  Container that runs Mocha, with this project as the working directory and
  the instrumentation preloaded. With a package.json at or above the project,
  the install root's dependencies are installed and the source laid over
  them; otherwise npx fetches Mocha on demand.
  """
  let runner(ws: Workspace!): Container! {
    runnerBase(ws).withEnvVariable(
      "NODE_OPTIONS",
      "$NODE_OPTIONS --require /dagger-mocha/lib/dist/cjs/register.cjs",
      expand: true,
    )
  }

  """
  The runner without the instrumentation preloaded, for the runs that only
  list tests: a dry run emits Mocha's events too, so an instrumented one
  would record spans for tests that never ran.
  """
  let runnerBase(ws: Workspace!): Container! {
    let root = installRoot(ws)
    let mount = root ?? path
    let source = ws.directory(
      "/" + mount,
      exclude: ["**/node_modules", ".git"],
      gitignore: true,
    )
    let ctr = if (root == null) {
      tool.nodeBase("npm").withDirectory(tool.containerPath(mount), source)
    } else {
      installed(ws, root ?? ".")
        .withDirectory(tool.containerPath(mount), source)
        # 493 is 0755.
        .withNewFile("/usr/local/bin/mocha", wrapper(root ?? "."), permissions: 493)
    }
    let dir = tool.relativeTo(mount, path)
    let configured = tool.environment.reduce(ctr) { acc, pair =>
      let key = pair.replaceMatches(`(?s)=.*$`, with: "")
      acc.withEnvVariable(key, pair.trimPrefix(key + "="))
    }
    let workdir = configured.withWorkdir(tool.containerPath(path))
    let built = if (tool.build and root != null) {
      let ran = workdir.withExec(
        [packageManager(ws, root ?? "."), "run", "build"],
        expect: ReturnType.ANY,
      )
      let code = ran.exitCode
      if (code != 0) {
        let output = (ran.stdout.trim(" \n") + "\n" + ran.stderr.trim(" \n")).trim(" \n")
        raise "build failed (" + packageManager(ws, root ?? ".") + " run build, exit "
          + toString(code) + "):\n" + output.split("\n").takeLast(15).join("\n")
      }
      ran
    } else {
      workdir
    }
    built
      .withDirectory("/dagger-mocha/lib", tool.library)
      .withNewFile("/dagger-mocha/timeout.sh", timeoutScript)
      .withEnvVariable("DAGGER_MOCHA_TIMEOUT", toString(tool.timeout))
  }

  """
  Container that has listed, without running them, the tests the project's
  own Mocha config selects. The run may have failed: read exitCode.
  """
  let dryRun(ws: Workspace!, args: [String!]!): Container! {
    let install = installFailure(ws)
    if (install != null) {
      raise "Mocha failed in " + path + ": " + (install ?? "")
    }
    runnerBase(ws).withExec(
      mocha(ws, ["--dry-run"] + tool.flags + args),
      expect: ReturnType.ANY,
    )
  }

  # Test files are found with ripgrep searches over the project, rather than
  # by asking Mocha, so listing them runs no container, installs nothing and
  # never walks node_modules. Only what Mocha reads from a JSON or YAML config
  # is followed: spec, extension, recursive and ignore. A JS config is not
  # evaluated and the `mocha` key of package.json is not read, so such a
  # project is assumed to use Mocha's defaults. A file is a test file only
  # when it calls describe, context, suite, it, specify or test, so helpers in
  # the spec are not listed. Where this still disagrees with Mocha, a listed
  # file Mocha runs no test from fails as not run, and a failure in a file
  # Mocha runs but this did not list fails every check of the project.
  let testFilePaths(ws: Workspace!): [String!]! {
    let text = configText(ws)
    let specs = if (text == null) { null } else { specOption(text ?? "") }
    let extensions = if (text == null) { null } else { extensionOption(text ?? "") }
    let ignored = if (text == null) { null } else { ignoreOption(text ?? "") }
    let recursive = if (text == null) { false } else { recursiveOption(text ?? "") }
    let empty: [String!]! = []
    let globs = (specs ?? ["./test"]).reduce(empty) { acc, spec =>
      acc + specGlobs(spec, extensions ?? ["js", "cjs", "mjs"], recursive)
    }
    if (globs.length == 0) {
      empty
    } else {
      let excluded = (ignored ?? empty)
        .map { glob => glob.trimPrefix("./") }
        .filter { glob => glob.hasPrefix("/") == false and glob.hasPrefix("../") == false }
        .map { glob => "!/" + globPrefix + glob }
      let found = ws.search(
        paths: [absolutePath],
        globs: globs + excluded + ["!node_modules", "!.git"],
        pattern: `\b(describe|context|suite|it|specify|test)(\.(only|skip))?\s*\(`,
        filesOnly: true,
      ).{{filePath}}.map { match => relativePath(match.filePath) }
      # Nested projects own the files below them.
      let nested = ws.search(
        paths: [absolutePath],
        globs: ["/" + globPrefix + "**/.mocharc.*", "!node_modules", "!.git"],
        pattern: "",
        filesOnly: true,
      ).{{filePath}}
        .map { match => relativePath(match.filePath) }
        .filter { file => file.contains("/") and isConfigFile(file) }
        .map { file => file.split("/").dropLast(1).join("/") + "/" }
      tool.sorted(
        found
          .filter { file =>
            isConfigFile(file) == false and nested.any { root => file.hasPrefix(root) } == false
          }
          .uniq,
      )
    }
  }

  let relativePath(found: String!): String! {
    found.trimPrefix("/").trimPrefix("./").trimPrefix(globPrefix)
  }

  """
  Whether a project-relative file is a Mocha config.
  """
  let isConfigFile(file: String!): Boolean! {
    tool.configNames.any { name => file == name or file.hasSuffix("/" + name) }
  }

  """
  Root-anchored search globs for one spec entry, as Mocha reads it: a glob
  matches files, and a plain path names a file, the same path with one of the
  extensions, or a directory whose files with those extensions it holds (at any
  depth when recursive). Entries outside the project match nothing.
  """
  let specGlobs(spec: String!, extensions: [String!]!, recursive: Boolean!): [String!]! {
    let relative = spec.trimPrefix("./").trimSuffix("/")
    let empty: [String!]! = []
    if (relative.hasPrefix("/") or relative == ".." or relative.hasPrefix("../")) {
      empty
    } else {
      let local = if (relative == "." or relative == "") { "" } else { relative }
      let base = "/" + globPrefix + local
      if (relative.containsMatch(`[*?\[{]`)) {
        [base]
      } else {
        let exts = extensions.map { ext => ext.trimPrefix(".") }
        let alternatives = if (exts.length == 1) { exts.join("") } else {
          "{" + exts.join(",") + "}"
        }
        let dir = if (base.hasSuffix("/")) { base } else { base + "/" }
        let depth = if (recursive) { "**/" } else { "" }
        let files = [dir + depth + "*." + alternatives]
        if (base.hasSuffix("/")) { files } else { [base, base + "." + alternatives] + files }
      }
    }
  }

  """
  The name of the config file Mocha loads for this project, in Mocha's own
  lookup order.
  """
  let configName(ws: Workspace!): String! {
    let present = ws.glob(globPrefix + ".mocharc.*").map { m =>
      m.trimPrefix("/").trimPrefix("./").trimPrefix(globPrefix)
    }
    tool.configLookupOrder.filter { name => present.contains(name) }.takeFirst(1).join("")
  }

  """
  The config file Mocha loads for this project, as JSON or YAML text; null
  when there is none or it is JavaScript.
  """
  let configText(ws: Workspace!): String {
    let loaded = configName(ws)
    if (loaded == "" or loaded.hasSuffix("js")) {
      null
    } else {
      let text = ws.file("/" + globPrefix + loaded).contents
      if (loaded.hasSuffix(".yaml") or loaded.hasSuffix(".yml")) {
        text
      } else {
        # Mocha strips comments from JSON configs, but not from inside strings
        # such as "test/**/*.js", so strings are matched to be kept. What is
        # left is YAML too, once tabs, which JSON only allows as whitespace,
        # are spaces.
        text
          .rewriteMatches(`"(?:[^"\\]|\\.)*"|(?s:/\*.*?\*/)|//[^\n]*`) { m =>
            if (m.string.hasPrefix("\"")) { m.string } else { "" }
          }
          .replace("\t", " ")
      }
    }
  }

  """
  The config's spec, as a list whether Mocha was given a string or a list;
  null when it is unset or neither.
  """
  let specOption(text: String!): [String!] {
    {
      let config = YAML.decode(text) :: {{spec: [String!]}}!
      config.spec
    } rescue {
      err: Error => {
        let config = YAML.decode(text) :: {{spec: String}}!
        if (config.spec == null) { null } else { [config.spec ?? ""] }
      } rescue {
        err: Error => null
      }
    }
  }

  """
  The config's test file extensions, as a list whether Mocha was given a
  string or a list; null when it is unset or neither.
  """
  let extensionOption(text: String!): [String!] {
    {
      let config = YAML.decode(text) :: {{extension: [String!]}}!
      config.extension
    } rescue {
      err: Error => {
        let config = YAML.decode(text) :: {{extension: String}}!
        if (config.extension == null) { null } else { [config.extension ?? ""] }
      } rescue {
        err: Error => null
      }
    }
  }

  """
  The config's ignore globs, as a list whether Mocha was given a string or a
  list; null when it is unset or neither.
  """
  let ignoreOption(text: String!): [String!] {
    {
      let config = YAML.decode(text) :: {{ignore: [String!]}}!
      config.ignore
    } rescue {
      err: Error => {
        let config = YAML.decode(text) :: {{ignore: String}}!
        if (config.ignore == null) { null } else { [config.ignore ?? ""] }
      } rescue {
        err: Error => null
      }
    }
  }

  """
  Whether the config asks Mocha to read spec directories recursively.
  """
  let recursiveOption(text: String!): Boolean! {
    {
      let config = YAML.decode(text) :: {{recursive: Boolean}}!
      config.recursive ?? false
    } rescue {
      err: Error => false
    }
  }
}

"""
Test files in a Mocha project, keyed by project-relative path.
"""
type MochajsTestFiles @collection {
  """
  Test file paths, relative to the project root.
  """
  files: [String!]! @keys

  """
  Test files selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed test files from this collection.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  """
  Stored test collections for the files. The engine filters these
  collections too when it passes a selected set of test files.
  """
  entries: [MochajsTestFileSelection!]!

  let project: MochajsProject!

  """
  Why the project's test files could not be found, or null. Its only key is
  then the project's Mocha config, whose check fails with this.
  """
  let discoveryError: String

  """
  The test file at this path.
  """
  file(path: String!): MochajsTestFile! @get {
    MochajsTestFile(
      path: path,
      project: project,
      tests: entries.filter { entry => entry.path == path }[0]!.tests,
    )
  }

  """
  Run the selected test files in this project. A plain function, not a check:
  each test is a check, so dagger check does not run the same tests twice.
  """
  test(ws: Workspace!): Void {
    if (discoveryError != null) {
      raise "Mocha failed in " + project.path + ": " + (discoveryError ?? "")
    }
    # With nothing selected out, run the project as Mocha's own config selects
    # it rather than naming every file. Without a delta, naming the files is
    # the safe choice.
    if (narrowed == false) {
      project.test(ws)
    } else if (files.length > 0) {
      project.runFiles(ws, files, "")
    }
    null
  }
}

"""
A test file and its tests, as stored in its project's test files.
"""
type MochajsTestFileSelection {
  """
  Test file path, relative to the project root.
  """
  path: String!

  """
  The tests in this file.
  """
  tests: MochajsTests!
}

"""
A Mocha test file.
"""
type MochajsTestFile {
  """
  Test file path, relative to the project root.
  """
  path: String!

  let project: MochajsProject!

  """
  The tests in this file, keyed by the full title Mocha reports, plus "*"
  for the tests the source does not name.
  """
  tests: MochajsTests!

  """
  Run the Mocha tests in this test file. A plain function, not a check: the
  tests below it are the checks.
  """
  test(ws: Workspace!): Void {
    project.runFiles(ws, [path], "")
  }
}

"""
Tests in a Mocha test file, keyed by the full title --grep matches: the
literal titles of the suites around a test and its own, joined by spaces.
The key "*" stands for the file's tests whose titles the source does not
spell out (made in a loop, a helper or a forEach callback, or by a suite
whose title is not a literal).
"""
type MochajsTests @collection {
  """
  Full titles, in source order, then "*" when the file has unnamed tests.
  """
  titles: [String!]! @keys

  """
  Tests selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed tests from this collection.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  """
  Every full title the source names, so that "*" can stand for the others.
  """
  let statics: [String!]!

  """
  Whether the file calls .only, which in Mocha holds every file of the run.
  """
  let only: Boolean!

  """
  Test file path, relative to the project root.
  """
  let path: String!

  let project: MochajsProject!

  """
  The test with this full title, or "*".
  """
  named(title: String!): MochajsTest! @get {
    MochajsTest(title: title, path: path, project: project)
  }

  """
  Run the selected tests of this file. A plain function, not a check: each
  test is a check, so dagger check does not run the same tests twice.
  """
  test(ws: Workspace!): Void {
    if (narrowed == false) {
      project.runFiles(ws, [path], "")
    } else if (titles.length > 0) {
      let grep = project.grepFor(
        ws,
        [MochajsTestSelection(file: path, keys: titles, statics: statics, only: only, narrowed: true)],
      )
      project.runFiles(ws, [path], grep)
    }
    null
  }
}

"""
A Mocha test, or "*", the tests of its file the source does not name.
"""
type MochajsTest {
  """
  Full title: the titles of the suites around this test and its own.
  """
  title: String!

  """
  Test file path, relative to the project root.
  """
  let path: String!

  let project: MochajsProject!

  """
  Run this test. Every selected test of a project shares one Mocha run, and
  this check reports only its own result from it.
  """
  test(ws: Workspace!, selection: MochajsTestFiles!): Void @check {
    project.runTests(ws, selection).assertPassed(path, title)
  }
}

"""
The selected tests of one test file, as the shared run was given them.
"""
type MochajsTestSelection {
  let file: String!
  let keys: [String!]!
  let statics: [String!]!
  let only: Boolean!
  let narrowed: Boolean!
}

"""
One result per selected test, written by the shared indexer, each small
whatever the size of Mocha's report.
"""
type MochajsTestResults {
  let results: Directory!
  let selections: [MochajsTestSelection!]!

  """
  The project root, for messages.
  """
  let project: String!

  """
  Raise this test's failure, if any. Results are filed by the positions of
  the file and the key in the selection, which every check of the run
  received identically, so titles never become file names.
  """
  let assertPassed(file: String!, title: String!): Void {
    let fileIndex = selections.takeWhile { s => s.file != file }.length
    if (fileIndex == selections.length) {
      raise "Mocha test file is outside the test selection: " + file
    }
    let keys = selections[fileIndex]!.keys
    let keyIndex = keys.takeWhile { k => k != title }.length
    if (keyIndex == keys.length) {
      raise "Mocha test is outside the selection: " + title
    }
    let failure = results.file(toString(fileIndex) + "/" + toString(keyIndex)).contents
    if (failure != "") {
      raise "Mocha failed in " + project + ": " + failure
    }
    null
  }
}
